{
  "name": "java-ui-automation",
  "displayName": "Java UI Automation Test",
  "description": "Java Application UI automation testing plugin - scan UI elements, generate test scripts",
  "version": "0.1.0",
  "publisher": "mars",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onCommand:javaUiAutomation.scanUi",
    "onCommand:javaUiAutomation.generateScript",
    "onCommand:javaUiAutomation.selectProcess",
    "onCommand:javaUiAutomation.showPanel",
    "onView:javaUiAutomation.panel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "javaUiAutomation",
          "title": "Java UI Automation",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "javaUiAutomation": [
        {
          "type": "webview",
          "id": "javaUiAutomation.panel",
          "name": "UI Inspector"
        }
      ]
    },
    "commands": [
      {
        "command": "javaUiAutomation.scanUi",
        "title": "Java UI: Scan Application UI Elements"
      },
      {
        "command": "javaUiAutomation.generateScript",
        "title": "Java UI: Generate Test Script"
      },
      {
        "command": "javaUiAutomation.selectProcess",
        "title": "Java UI: Select Java Process and Scan"
      },
      {
        "command": "javaUiAutomation.showPanel",
        "title": "Java UI: Show Panel"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "build:java": "cd java && mvn clean package -DskipTests && cd ..",
    "build:processinfo": "cd ProcessInfo && dotnet publish -c Release && cd .."
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
