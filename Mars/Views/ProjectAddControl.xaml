<mb:MarsProjectBaseControlView x:Class="Mars.Views.ProjectAddControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"                        
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mb="clr-namespace:Mars.Views.baseView" 
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Mars.ViewModel"             
             xmlns:con="clr-namespace:Mars.Converter" 
             xmlns:Helper="clr-namespace:Mars.Helpers"
              d:DesignHeight="500" d:DesignWidth="571"
                        mb:Title="{Binding Title}">

    <UserControl.Resources>
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
        <DataTemplate x:Key="myTemplate" DataType="ValidationExample.MyData">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Division: "/>
                <TextBlock Text="{Binding Path=Division}"/>
            </StackPanel>
        </DataTemplate>

        <ControlTemplate x:Key="errorTemplate">
            <StackPanel>
                <TextBlock Foreground="Red">Invalid Value!!!</TextBlock>
                <AdornedElementPlaceholder/>
            </StackPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="TextBoxErrorTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" 
        Foreground="Orange"  FontSize="12pt">!</TextBlock>

                <Border BorderBrush="Red" BorderThickness="1">
                    <AdornedElementPlaceholder />
                </Border>
            </DockPanel>
        </ControlTemplate>

    </UserControl.Resources>
    <Border CornerRadius="5" BorderBrush="LightGray" BorderThickness="1" Padding="5" Margin="0,0,5,0">
     <Grid Margin="0,0,0,0">                
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="72"></RowDefinition>
            <RowDefinition Height="Auto" MaxHeight="600" ></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
        <!--Defined Column-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto" MinWidth="1"></ColumnDefinition>
            <ColumnDefinition Width="*" MinWidth="473"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  Margin="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <Label x:Name="lblHeader" Content="Project Add" FontSize="20" Margin="5" ></Label>
        </StackPanel>
        <!--First Column Content-->

        <Label Content="Name of project" Grid.Column="0" Grid.Row="1" Margin="5" ></Label>
        <Label Content="Description" Grid.Column="0" Grid.Row="2" Margin="5" ></Label>
        <Label Content="Application" Grid.Column="0" Grid.Row="3" Margin="5" ></Label>
        <Label Content="Status" Grid.Column="0" Grid.Row="4" Margin="5" ></Label>

        <!--Second Column Content-->

        <TextBox Name="txtProjectName" Validation.ErrorTemplate="{StaticResource TextBoxErrorTemplate}" 
                 Validation.Error="ValidationError" Grid.Column="2" Grid.Row="1" Margin="5"
                 >
            <TextBox.Text>
                <Binding Path="ProjectName" UpdateSourceTrigger="PropertyChanged"  NotifyOnValidationError="True">                    
                </Binding>
            </TextBox.Text>
        </TextBox>
<!--
        <ComboBox x:Name="cbxProject"
                  Grid.Column="2" Grid.Row="1"                   
                  ItemsSource="{Binding Path=ProjectList}"
                  SelectedIndex="{Binding Path=ProjectId,Mode=TwoWay}"
                  SelectedValuePath="PROJECT_ID"
                  DisplayMemberPath="PROJECT_NAME"
                  Margin="4,5,10,5">            
        </ComboBox>
-->
        <TextBox Name="txtProjectDescription" Validation.ErrorTemplate="{StaticResource TextBoxErrorTemplate}" Validation.Error="ValidationError" 
                 IsEnabled="{Binding isEditMode}"
                 Grid.Column="2" Grid.Row="2" Margin="5"
                 TextWrapping="WrapWithOverflow" AcceptsReturn="True"
                 >
            <TextBox.Text>
                <Binding Path="ProjectDescription" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True" >                    
                </Binding>
            </TextBox.Text>
        </TextBox>

        <ListView Name="listViewClients" Grid.Column="2" Grid.Row="3" Margin="5" 
                  
                  ItemsSource="{Binding Path=RegisterdApplication}"                  
                  MaxHeight="500" MinWidth="600"
                  IsSynchronizedWithCurrentItem="True"
                  Helper:GridViewSort.AutoSort="True"
                  IsEnabled="{Binding isEnableEdit}">
            <ListView.Resources>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Select" Width="50" Helper:GridViewSort.PropertyName="IsSelected">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Application" Width="auto" DisplayMemberBinding="{Binding APP_SHORT_NAME}" 
                                    Helper:GridViewSort.PropertyName="APP_SHORT_NAME"/>
                    <GridViewColumn Header="Version" Width="100" DisplayMemberBinding="{Binding VERSION}" 
                                    Helper:GridViewSort.PropertyName="VERSION"/>
                </GridView>
            </ListView.View>
        </ListView>

        <ComboBox x:Name="cbxProjectStatus" Grid.Column="2" Grid.Row="4"                    
                      ItemsSource="{Binding StatusSource}" SelectedIndex="{Binding ProjectStatus, Mode=TwoWay}" SelectedValuePath="Key" 
                  IsEnabled="{Binding isEditMode}"
                  DisplayMemberPath="Value"  Margin="5">

        </ComboBox>
            <Border Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="LightGray" Margin="2">
                
            </Border>
        <WrapPanel Grid.Column="2" Grid.Row="5" >
                <!--
                <Button Content="{Binding editButtonCaption}" Width="70" Height="24" Margin="5" Command="{Binding EnableEditCommand}"
                        
                        ></Button>
                -->
                <Button Content="Save" Width="70" Height="24" Margin="5" Command="{Binding SaveCommand}"></Button>
            <Button x:Name="btnCancel" Content="Cancel" Width="70" Height="24" Margin="5" Command="{Binding ClearCommand}"></Button>
        </WrapPanel>

        <WrapPanel Grid.Column="2" Grid.Row="6" >
                <TextBlock Name="ProjectControlStatus" Text="{Binding ProjectControlStatus}" FontWeight="Bold" Background="#FFF5E008" />
        </WrapPanel>

            <!--Third Column Content-->

        <!--Image Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" Margin="21,10" Width="1000" /-->
        
    </Grid>
    </Border>

</mb:MarsProjectBaseControlView>


