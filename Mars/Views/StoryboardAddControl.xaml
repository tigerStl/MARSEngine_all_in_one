<mars:MarsBaseViewControl x:Class="Mars.Views.StoryboardAddControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vab="clr-namespace:Microsoft.Practices.EnterpriseLibrary.Validation.Integration.WPF;assembly=Microsoft.Practices.EnterpriseLibrary.Validation.Integration.WPF"
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:Helper="clr-namespace:Mars.Helpers"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800">
    <!--Title="Storyboard Add"-->
    <UserControl.Resources>
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
    </UserControl.Resources>
    
        <Border BorderBrush="LightGray" CornerRadius="5" BorderThickness="1" Grid.Column="0" Grid.Row="0">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="128"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <!--Defined Column-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" ></ColumnDefinition>
                <ColumnDefinition Width="3"></ColumnDefinition>
                <ColumnDefinition Width="*" MaxWidth="2048" MinWidth="300"></ColumnDefinition>
                
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <Label x:Name="lblHeader" Content="Storyboard Add" FontSize="20" />

            </StackPanel>
            <!--First Column Content-->

            <Label Content="Storyboard Name" Grid.Column="0" Grid.Row="1" Margin="5" ></Label>
            <Label Content="Description" Grid.Column="0" Grid.Row="2" Margin="5" ></Label>
           

            <!--Second Column Content-->

            <TextBox Name="storyboardName" Grid.Column="2" Grid.Row="1" Margin="5">
                <TextBox.Text>
                    <Binding Path="StoryboardName" UpdateSourceTrigger="PropertyChanged" >
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <TextBox Name="storyboardDescription" Grid.Column="2" Grid.Row="2" Margin="5" TextWrapping="Wrap"
                        AcceptsReturn="True" >
                <TextBox.Text>
                    <Binding Path="StoryboardDescription" UpdateSourceTrigger="PropertyChanged" >                        
                    </Binding>
                </TextBox.Text>
            </TextBox>

            
            <StackPanel Grid.Column="2" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" >
                <Button Content="Save" Width="70" Height="24" Margin="5" Click="Button_Click" >
                </Button>
                <Button x:Name="btnCancel" Content="Cancel" Width="70" Height="24" Margin="5" Command="{Binding ClearCommand}"></Button>
            </StackPanel>

        </Grid>
    </Border>

</mars:MarsBaseViewControl>
