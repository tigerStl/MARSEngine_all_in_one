<mars:MarsBaseViewControl x:Class="Mars.Views.TestApplicationRegistration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.Views"             
                          xmlns:mars="clr-namespace:Mars.Views.baseView"

             xmlns:md="clr-namespace:Mars.ViewModel"             
             xmlns:db="clr-namespace:Mars.Business;assembly=Mars.DB"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
                   >

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="True" x:Name="_ElementContainers" >
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition Height="1*" MinHeight="200"></RowDefinition>
                            <RowDefinition Height="*" MinHeight="200"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="Application Amend:" FontSize="18" FontWeight="Bold" x:Name="lblHeader"></Label>
                        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="LightGray" Margin="1"></Border>
                        <Label Grid.Row="1" Grid.Column="0" Content="Registed Applications:"  FontSize="12"></Label>
                        <ListView DockPanel.Dock="Left" Margin="20,0,0,0" Width="auto" Grid.Row="2"
                              ItemsSource="{Binding RegisteredApplications}" ScrollViewer.HorizontalScrollBarVisibility="Visible" 
                              SelectionMode="Single" SelectedItem="{Binding SelectedApplication}"
                              >
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Exists">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Label x:Name="UIElementStatusOfApp" Content="{Binding Status}"></Label>
                                                <DataTemplate.Triggers>
                                                    <!--ItemsSource="{Binding Source={x:Static db:B_REGISTERED_APPS.APPLICATION_TYPE_LIST},Mode=OneWay}"-->
                                                    <DataTrigger Binding="{Binding Path=Status}" Value="{x:Static md:RegistedTestApplication.CNST_NOT_CONFIGURED}">
                                                        <Setter Property="Foreground" TargetName="UIElementStatusOfApp" Value="Red"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:RegistedTestApplication.CNST_PATH_NOT_CHECKABLE}">
                                                        <Setter Property="Foreground" TargetName="UIElementStatusOfApp" Value="OrangeRed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:RegistedTestApplication.CNST_PATH_WRONG}">
                                                        <Setter Property="Foreground" TargetName="UIElementStatusOfApp" Value="Crimson"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>
                                    <GridViewColumn Header="Short Name" DisplayMemberBinding="{Binding ApplicationShortName}" Width="100">

                                    </GridViewColumn>
                                    <GridViewColumn Header="Start Path" DisplayMemberBinding="{Binding StarterPath}" Width="300">

                                    </GridViewColumn>
                                    <GridViewColumn Header="Application Type" DisplayMemberBinding="{Binding ApplicationType.Value}" Width="100" >

                                    </GridViewColumn>
                                    <GridViewColumn Header="Required Addins" DisplayMemberBinding="{Binding RequirementsForAddins}" Width="300">

                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <DockPanel Grid.Row="3" x:Name="ApplicationDetailContainer">
                            <Border BorderThickness="0,1,0,1" BorderBrush="LightGray" Margin="1,5,1,3" DockPanel.Dock="Top">
                                <Label Content="Details:" FontSize="14" FontWeight="Bold" Margin="2"></Label>
                            </Border>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MaxWidth="140"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Content="Application Short Name:" Margin="2" FontSize="12"></Label>
                                <Label HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" Content="Start Path:" Margin="2"  FontSize="12"></Label>
                                <Label HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0" Content="Application Type:" Margin="2" FontSize="12"></Label>
                                <Label HorizontalAlignment="Left" Grid.Row="3" Grid.Column="0" Content="Required Addins:" Margin="2" FontSize="12"></Label>

                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedApplication.ApplicationShortName}" Margin="2">

                                </TextBox>


                                <TextBox Grid.Row="1" Grid.Column="1" Margin="2,2,85,2" Text="{Binding SelectedApplication.StarterPath}"></TextBox>
                                <Button Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Right" Margin="0,2,2,0" Content="Open" Command="{Binding CmdSelectTargetApplication}" Height="23" VerticalAlignment="Top"></Button>

                                <DockPanel Grid.Column="1" Grid.Row="2" LastChildFill="True" Margin="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition ></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"  SelectedValue="{Binding SelectedApplication.ApplicationType}" ItemsSource="{Binding Source={x:Static db:B_REGISTERED_APPS.APPLICATION_TYPE_LIST},Mode=OneWay}" DisplayMemberPath="Value">
                                        </ComboBox>
                                        <Label Content="Application Identifier:" Grid.Column="1" Margin="3"></Label>
                                        <TextBox Grid.Column="2" Text="{Binding SelectedApplication.ApplicationIdentifier,Mode=TwoWay}"></TextBox>
                                    </Grid>
                                </DockPanel>
                                <DockPanel Grid.Column="1" Grid.Row="3" LastChildFill="True" x:Name="ExtraRequireContainer" Margin="2">
                                    <TabControl DockPanel.Dock="Left" Background="Transparent" x:Name="tabContainer"
                                            HorizontalAlignment="Left" Height="180" MinWidth="200" MaxWidth="400"
                                            Width="{Binding Path=ActualWidth, ElementName=ExtraRequireContainer}" >
                                        <TabItem Header="Infragistics Support">
                                            <ListBox Width="{Binding Path=ActualWidth, ElementName=tabContainer}"
                                                 ItemsSource="{Binding Source={x:Static db:B_REGISTERED_APPS.APPLICATION_ADDINS_INFRAGISTICS}}" 
                                                 SelectedItem="{Binding SelectedApplication.InfragisticSupport}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                 >

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton GroupName="InfragisticsSupport" Content="{Binding Value}" IsChecked="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Path=IsSelected}">

                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </TabItem>
                                        <TabItem Header="Develop Express">
                                            <ListBox Width="{Binding Path=ActualWidth, ElementName=tabContainer}"
                                                 ItemsSource="{Binding Source={x:Static db:B_REGISTERED_APPS.APPLICATION_ADDINS_DEVEXP}}"
                                                 SelectedItem="{Binding SelectedApplication.DevExpressSupport}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                 >
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton Content="{Binding Value}" GroupName="DevExpressSupport"  IsChecked="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Path=IsSelected}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                        </TabItem>
                                    </TabControl>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Vertical" Margin="12,10,2,2" HorizontalAlignment="Center">
                                        <Button Content="{Binding Source={x:Static md:TestApplicationRegistrationViewModel.CNST_CMD_SAVE} }" Margin="5" Width="120" Command="{Binding ModelButtonCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"></Button>
                                        <Button Content="{Binding Source={x:Static md:TestApplicationRegistrationViewModel.CNST_CMD_DELETE} }" Margin="5" Width="120" Command="{Binding ModelButtonCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"></Button>
                                        <Button Content="{Binding Source={x:Static md:TestApplicationRegistrationViewModel.CNST_CMD_ADDTOLOCAL}}" Margin="5" Width="120" Command="{Binding ModelButtonCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"></Button>
                                        <Button Content="{Binding Source={x:Static md:TestApplicationRegistrationViewModel.CNST_CMD_CLEAR_LOCAL}}" Margin="5" Width="120" Command="{Binding ModelButtonCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"></Button>
                                        <Button Content="{Binding Source={x:Static md:TestApplicationRegistrationViewModel.CNST_CMD_DELETE_SERVER}}" Margin="5" Width="120" Command="{Binding ModelButtonCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"></Button>
                                    </StackPanel>
                                    <StackPanel></StackPanel>
                                </DockPanel>

                            </Grid>
                        </DockPanel>
                    </Grid>
                </Border>


            </DockPanel>


            <!-- #endregion end 2nd -->
        </Grid>
    </ScrollViewer>
</mars:MarsBaseViewControl>
