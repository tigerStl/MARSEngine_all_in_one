<mars:MarsBaseViewControl x:Class="Mars.Views.ApplicationPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <!--Title="Application Properties"-->
    <Border CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <!--Defined Column-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel 
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3">
                <Label Content="Application Properties" x:Name="lblTitle"
                   FontSize="20" >
                </Label>
            </StackPanel>
            <!--First Column Content-->
            <Label Content="Application"
               Grid.Column="0"
               Grid.Row="1"
               Margin="5">
            </Label>
            <Label Content="Description"
               Grid.Column="0"
               Grid.Row="2"
               Margin="5">
            </Label>
            <Label Content="Created At"
               Grid.Column="0"
               Grid.Row="3"
               Margin="5">
            </Label>
            <!--Second Column Content-->
            <ComboBox x:Name="cbxApplication"
                  SelectedIndex="1" 
                  Grid.Column="2" 
                  Grid.Row="1"                    
                  ItemsSource="{Binding Path=RegisterdApplication}"
                  SelectedValuePath="APP_SHORT_NAME"
                  SelectedItem="{Binding SelectedApplication}"
                      MinWidth="200"
                  Margin="4">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} v{1}">
                                    <Binding Path="APP_SHORT_NAME"/>
                                    <Binding Path="VERSION"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>


            <TextBox Name="txtApplicationDescription"
                     Grid.Column="2"
                     Grid.Row="2"
                     DataContext="{Binding SelectedApplication}"
                     Text="{Binding PROCESS_IDENTIFIER}"
                     MinWidth="200"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     MaxWidth="600"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                 Margin="4">
            </TextBox>
            <TextBox Name="txtApplicationCreatedAt"
                 Grid.Column="2"
                 Grid.Row="3"
                 DataContext="{Binding SelectedApplication}"
                 IsEnabled="False"
                 Text="{Binding RECORD_CREATE_DATE}"
                     MinWidth="200"
                 Margin="4">
            </TextBox>

            <WrapPanel Grid.Column="3"
                   Grid.Row="4">
                <Button Content="Save"
                    Width="70"
                    Height="24"
                    Margin="5"
                    Command="{Binding EditCommand}">
                </Button>
                <Button Content="Cancel"
                    Width="70"
                    Height="24"
                    Margin="5"
                    Command="{Binding ClearCommand}">
                </Button>
            </WrapPanel>

            <WrapPanel Grid.Column="3" Grid.Row="5" >
                <TextBlock Name="ApplicationControlStatus" Text="{Binding ApplicationControlStatus}" FontWeight="Bold" Background="#FFF5E008" />
            </WrapPanel>            
        </Grid>
    </Border>
</mars:MarsBaseViewControl>
