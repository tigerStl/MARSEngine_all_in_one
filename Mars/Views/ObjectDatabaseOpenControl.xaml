<mars:MarsBaseViewControl x:Class="Mars.Views.ObjectDatabaseOpenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:v="clr-namespace:Mars.Views"
             xmlns:Helper="clr-namespace:Mars.Helpers"
                          xmlns:objSrc="clr-namespace:Mars.Views.objectManagement"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600" Loaded="MarsBaseViewControl_Loaded">
    <!--Title="Object Management"-->
    <UserControl.Resources>
        <!--
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
        <DataTemplate x:Key="myTemplate" DataType="ValidationExample.MyData">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Division: "/>
                <TextBlock Text="{Binding Path=Division}"/>
            </StackPanel>
        </DataTemplate>
-->
        <Style x:Key="GridSplitterPreviewStyle" >
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Fill="#80000000"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <ControlTemplate x:Key="errorTemplate">
            <StackPanel>
                <TextBlock Foreground="Red">Invalid Value!!!</TextBlock>
                <AdornedElementPlaceholder/>
            </StackPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="TextBoxErrorTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" 
        Foreground="Orange"  FontSize="12pt">!</TextBlock>

                <Border BorderBrush="Red" BorderThickness="1">
                    <AdornedElementPlaceholder />
                </Border>
            </DockPanel>
        </ControlTemplate>

        <Style x:Key="GridSplitterVer" TargetType="{x:Type GridSplitter}">
            <Setter Property="Background"
                Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" >
                            <Canvas RenderOptions.EdgeMode="Aliased" UseLayoutRounding="True"
                                Height="16" VerticalAlignment="Center"
                                Width="7" HorizontalAlignment="Center">
                                <Line X1="0" X2="0" Y1="0" Y2="50"
                                  Stroke="White" StrokeThickness="1"/>
                                <Line X1="1" X2="1" Y1="0" Y2="50"
                                  Stroke="#A0A0A0" StrokeThickness="1"/>
                                <Line X1="4" X2="4" Y1="0" Y2="50"
                                  Stroke="White" StrokeThickness="1"/>
                                <Line X1="5" X2="5" Y1="0" Y2="50"
                                  Stroke="#A0A0A0" StrokeThickness="1"/>
                            </Canvas>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>

        </Grid.RowDefinitions>
        <!--Defined Column-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>            
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label x:Name="lblHeader" Grid.Column="0" Content="Object List" FontSize="20" Margin="0,0,0,0" ></Label>
                <DockPanel Grid.Column="2"  HorizontalAlignment="Right" Margin="0,0,5,0">
                    <Button PreviewMouseLeftButtonDown="Button_PreviewMouseDown" Margin="3" Width="20"
                        >
                        <Image Source="/Mars;component/Images/CrosshairsCursor.png"></Image>
                    </Button>
                    <Button Width="24"  Margin="3" Command="{Binding HighlightSelectedObjectButtonClick}" 
                            ToolTip="Highlight selected object">
                        <Image Source="/Mars;component/Images/target.png">
                        </Image>
                    </Button>
                </DockPanel>
                
            </Grid>
            
        </DockPanel>
        <!--First Column Content-->
        <Label Content="Name of Application" Grid.Column="0" Grid.Row="1" Margin="3" ></Label>

        <!--Second Column Content-->
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="3">
            <ComboBox x:Name="cbxApplication"
                      IsEditable="False"
                      Text="{Binding InputApplicationTxt,UpdateSourceTrigger=PropertyChanged}"
                  SelectedIndex="1" 
                  Grid.Column="1" 
                  Grid.Row="1"                    
                  ItemsSource="{Binding Path=RegisterdApplication}"
                  SelectedValuePath="APP_SHORT_NAME"
                  SelectedItem="{Binding SelectedApplication}"
                  Margin="3" Height="21" VerticalAlignment="Bottom" Width="180">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} v{1}">
                                    <Binding Path="APP_SHORT_NAME"/>
                                    <Binding Path="VERSION"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Margin="3" Command="{Binding ConvertObjectsToOtherApplication}"> Convert To</Button>
            <ComboBox x:Name="cbxTargetApplication"
                      IsEditable="False"
                      Text="{Binding InputApplicationTxt,UpdateSourceTrigger=PropertyChanged}"
                  SelectedIndex="1" 
                  Grid.Column="1" 
                  Grid.Row="1"                    
                  ItemsSource="{Binding Path=RegisterdApplication}"
                  SelectedValuePath="APP_SHORT_NAME"
                  SelectedItem="{Binding TargetSelectedApplication}"
                  Margin="3" Height="21" VerticalAlignment="Bottom" Width="180">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} v{1}">
                                    <Binding Path="APP_SHORT_NAME"/>
                                    <Binding Path="VERSION"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Label Content="Object Filter" Grid.Column="0" Grid.Row="2" Margin="3" ></Label>
        <TextBox Grid.Column="1" Grid.Row="2" Margin="3"  Name="txtFilter" TextChanged="txtFilter_TextChanged" />
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="7"></ColumnDefinition>
                <ColumnDefinition Width="1*" MinWidth="300"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
        
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" LastChildFill="True"  >
            <ListView Name="listViewObjects" 
                      ItemsSource="{Binding RegisterdObject}" 
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      SelectionMode="Single" 
                      SelectedItem="{Binding SelectedObject}"
                      DockPanel.Dock="Left"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      HorizontalAlignment="Stretch"                
                      VerticalAlignment="Stretch"
					  Helper:GridViewSort.AutoSort="True"
                      Margin="2,0,8,0"
                      MouseDoubleClick="listViewObjects_MouseDoubleClick"
                      >
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </ListView.Resources>
                    
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Object Name" Width="Auto" DisplayMemberBinding="{Binding OBJECT_HAPPY_NAME}" Helper:GridViewSort.PropertyName="OBJECT_HAPPY_NAME">
                        </GridViewColumn>
                        <GridViewColumn Header="Internal Name" Width="Auto" DisplayMemberBinding="{Binding QUICK_ACCESS}"
                                    Helper:GridViewSort.PropertyName="QUICK_ACCESS"/>
                        <GridViewColumn Header="Type" Width="Auto" DisplayMemberBinding="{Binding T_GUI_COMPONENT_TYPE_DIC.TYPE_NAME}" 
                                    Helper:GridViewSort.PropertyName="TYPE_ID"/>
                        <GridViewColumn Header="Parent / Peg window" Width="Auto" DisplayMemberBinding="{Binding OBJECT_TYPE}" 
                                    Helper:GridViewSort.PropertyName="OBJECT_TYPE"/>
                        <GridViewColumn Header="Enum Type" Width="Auto" DisplayMemberBinding="{Binding ENUM_TYPE, Mode=TwoWay}" 
                                    Helper:GridViewSort.PropertyName="ENUM_TYPE"/>
                        <GridViewColumn Header="Notes" Width="Auto" DisplayMemberBinding="{Binding COMMENT}" 
                                    Helper:GridViewSort.PropertyName="COMMENT" />
                    </GridView>
                    
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem 
                                Command="{Binding ExportToExcelCommand}" 
                                CommandParameter="{Binding PlacementTarget.ItemsSource, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Export To Excel" />

                        <MenuItem 
                                Command="{Binding AddToBatchConvert}" 
                                CommandParameter="{Binding PlacementTarget.ItemsSource, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Add to Batch Convert..." />
                        </ContextMenu>
                </ListView.ContextMenu>
                
            </ListView>
        </DockPanel>

        <GridSplitter   ResizeDirection="Columns"  Grid.Row="0" Grid.Column="1" 
                  VerticalAlignment="Stretch"  Width="7" 
                  BorderBrush="LightGray" BorderThickness="1"    
                  Style="{DynamicResource GridSplitterVer}"
                      />
        <DockPanel Grid.Column="2" Grid.Row="0"  LastChildFill="True" Width="auto" >
                <TabControl>
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Grid Name="Panel">
                                            <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="10,2"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Panel" Property="Background" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter TargetName="Panel" Property="Background" Value="Gray" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="Object Detail Editor">
                        <v:ObjectsEditControl DataContext="{Binding SelectedObjectCopy, Mode=OneWay}" x:Name="objectEdit" Width="auto" MinWidth="300"></v:ObjectsEditControl>
                    </TabItem>
                    <TabItem Header="Object DataSource">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition Height="32"></RowDefinition>
                            </Grid.RowDefinitions>
                            <objSrc:ObjectDataSourceDefinition Grid.Row="0"></objSrc:ObjectDataSourceDefinition>
                            
                        </Grid>
                    </TabItem>

                    <TabItem Header="Batch Convert">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition Height="32"></RowDefinition>
                            </Grid.RowDefinitions>
                            <ListView Name="ObjectsForBatchConvert" Grid.Row="0"
                      ItemsSource="{Binding RegisterdObjects4BatchConvert}" 
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      SelectionMode="Multiple"                                   
                      SelectedItem="{Binding SelectedObjects4BatchOP}"
                      DockPanel.Dock="Left"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      HorizontalAlignment="Stretch"                
                      VerticalAlignment="Stretch"
					  Helper:GridViewSort.AutoSort="True"
                      Margin="2,0,8,0"
                                  MouseDoubleClick="ObjectsForBatchConvert_MouseDoubleClick"
                      >
                                <ListView.Resources>
                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Object Name" Width="Auto" DisplayMemberBinding="{Binding OBJECT_HAPPY_NAME}" Helper:GridViewSort.PropertyName="OBJECT_HAPPY_NAME">
                                        </GridViewColumn>
                                        <GridViewColumn Header="Internal Name" Width="Auto" DisplayMemberBinding="{Binding QUICK_ACCESS}"
                                    Helper:GridViewSort.PropertyName="QUICK_ACCESS"/>
                                        <GridViewColumn Header="Type" Width="Auto" DisplayMemberBinding="{Binding T_GUI_COMPONENT_TYPE_DIC.TYPE_NAME}" 
                                    Helper:GridViewSort.PropertyName="TYPE_ID"/>
                                        <GridViewColumn Header="Parent / Peg window" Width="Auto" DisplayMemberBinding="{Binding OBJECT_TYPE}" 
                                    Helper:GridViewSort.PropertyName="OBJECT_TYPE"/>
                                        <GridViewColumn Header="Enum Type" Width="Auto" DisplayMemberBinding="{Binding ENUM_TYPE, Mode=TwoWay}" 
                                    Helper:GridViewSort.PropertyName="ENUM_TYPE"/>
                                        <GridViewColumn Header="Notes" Width="Auto" DisplayMemberBinding="{Binding COMMENT}" 
                                    Helper:GridViewSort.PropertyName="COMMENT"/>
                                    </GridView>

                                </ListView.View>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem 
                                Command="{Binding RemoveFromBatchConvertListCommand}" 
                                CommandParameter="{Binding PlacementTarget.ItemsSource, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Remove From List..." />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                            <Button Grid.Row="1" Width="40" Height="auto" Content="Clear" Margin="5" HorizontalAlignment="Right" Command="{Binding ClearConvertObjectsList}"></Button>
                        </Grid>
                    </TabItem>
                </TabControl>
                
                
               
            </DockPanel>
        </Grid>
    </Grid>

</mars:MarsBaseViewControl>
