<mars:MarsBaseViewControl x:Class="Mars.Views.ObjectLoadFromExcel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             xmlns:Helper="clr-namespace:Mars.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500">
    <!--Title="Object Import"-->
    <UserControl.Resources>
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
        <con:MarsBoolReverseConvert x:Key="boolConvert"></con:MarsBoolReverseConvert>
    </UserControl.Resources>
    <Border CornerRadius="5" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,5,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <!--Defined Column-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*" MaxWidth="600"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Margin="0,-3,-33,3">
                <Label x:Name="lblHeader" Content="Object Import" FontSize="20" Margin="5,0,0,0" ></Label>
            </StackPanel>
            <!--First Column Content-->
            <Label Content="Name of Application" Grid.Column="0" Grid.Row="1" Margin="5" ></Label>
            <Label Content="Excel File Name  " Grid.Column="0" Grid.Row="2" Margin="5" ></Label>

            <!--Second Column Content-->
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                <ComboBox x:Name="cbxApplication"
                  SelectedIndex="1" 
                  Grid.Column="1" 
                  Grid.Row="1"                    
                  ItemsSource="{Binding Path=RegisterdApplication}"
                  SelectedValuePath="APP_SHORT_NAME"
                  SelectedItem="{Binding SelectedApplication}" 
                  Margin="2" Height="21" VerticalAlignment="Bottom" Width="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} v[{1}]">
                                        <Binding Path="APP_SHORT_NAME"/>
                                        <Binding Path="VERSION"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBox x:Name="ExcelFileName" Grid.Column="1" Grid.Row="2" Margin="2,0,5,0" >
                <TextBox.Text>
                    <Binding Path="ExcelFileName" UpdateSourceTrigger="PropertyChanged" >
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <Button Content="Browse" Width="70" Height="23" Margin="1" Grid.Column="3" Grid.Row="2" Command="{Binding LoadCommand}" Click="Button_Click"></Button>
            <WrapPanel Grid.Column="1" Grid.Row="3" >
                <Button x:Name="btnLoad" Content="Load" Width="70" Height="24" Margin="5" Command="{Binding LoadFileCommand}" IsEnabled="{Binding Path=IsStartedToLoad,Converter={StaticResource boolConvert}}" ></Button>
                <Button x:Name="btnCancel" Content="Cancel" Width="70" Height="24" Margin="5" Command="{Binding ClearCommand}"></Button>
            </WrapPanel>
            <DockPanel Grid.Column="1" Grid.Row="4">
                <Label Content="Current Log:" DockPanel.Dock="Top"></Label>
                <Label Content="{Binding UploadLog}" DockPanel.Dock="Top" Height="20" Margin="16,0,0,4"></Label>
                <Label Content="Error Log:" DockPanel.Dock="Top" ></Label>
                <ListBox Background="Transparent" ItemsSource="{Binding errorList}"  ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="5">
                    
                </ListBox>
            </DockPanel>
            <Label Grid.Column="0" Grid.Row="4" Content="Current Load Info" Margin="5,0,0,0"></Label>
        </Grid>
    </Border>
</mars:MarsBaseViewControl>

