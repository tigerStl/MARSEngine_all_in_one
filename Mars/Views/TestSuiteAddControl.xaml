<mars:MarsBaseViewControl x:Class="Mars.Views.TestSuiteAddControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:Helper="clr-namespace:Mars.Helpers" >

    <UserControl.Resources>
            <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
        </UserControl.Resources>
    <Border BorderBrush="LightGray" CornerRadius="5" Margin="5,0,5,0" BorderThickness="1">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="5">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="96"></RowDefinition>
                <RowDefinition Height="200"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <!--Defined Column-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <Label x:Name="lblHeader"  Content="Test Suite Add" FontSize="20" ></Label>

            </StackPanel>
            <!--First Column Content-->

            <Label Content="Name of test suite" Grid.Column="0" Grid.Row="1" Margin="5" ></Label>
            <Label Content="Description" Grid.Column="0" Grid.Row="2" Margin="5" ></Label>
            <Label Content="Application" Grid.Column="0" Grid.Row="3" Margin="5" ></Label>
            <!--Second Column Content-->
            <!--SourceType="{x:Type local:TestSuiteViewModel}" -->
            <TextBox Name="txtTestSuiteName" Grid.Column="2" Grid.Row="1" Margin="5"
                     
                     >
                <TextBox.Text>
                    <Binding Path="TestSuiteName" UpdateSourceTrigger="PropertyChanged" >

                    </Binding>
                </TextBox.Text>
            </TextBox>
            <!--SourceType="{x:Type local:TestSuiteViewModel}"-->
            <TextBox Name="txtTestSuiteDescription" Grid.Column="2" Grid.Row="2" Margin="5"
                     >
                <TextBox.Text>
                    <Binding Path="TestSuiteDescription" UpdateSourceTrigger="PropertyChanged" >
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <ListView Name="listViewApplication" Grid.Column="2" Grid.Row="3" Margin="5" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                  ItemsSource="{Binding Path=RegisterdApplication}"                  
                      ScrollViewer.VerticalScrollBarVisibility="Auto" 
                      IsSynchronizedWithCurrentItem="True"
                     
                  Helper:GridViewSort.AutoSort="True">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Select" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Application" Width="300" DisplayMemberBinding="{Binding APP_SHORT_NAME}" Helper:GridViewSort.PropertyName="APP_SHORT_NAME" />
                        <GridViewColumn Header="Version" Width="100" DisplayMemberBinding="{Binding VERSION}"  Helper:GridViewSort.PropertyName="VERSION"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <WrapPanel Grid.Column="3" Grid.Row="8" >
                <Button Content="{Binding editButtonCaption}" Width="70" Height="24" Margin="5" Command="{Binding EditCommand}"
                        Visibility="Collapsed"
                        
                        ></Button>
                <Button Content="Save" Width="70" Height="24" Margin="5" Command="{Binding SaveCommand}"></Button>
                <Button x:Name="btnCancel" Content="Cancel" Width="70" Height="24" Margin="5" Command="{Binding ClearCommand}"></Button>
            </WrapPanel>

        </Grid>
    </ScrollViewer>
    </Border>
</mars:MarsBaseViewControl>
