<mars:MarsBaseViewControl x:Class="Mars.Views.ObjectDatabaseAmendControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:Helper="clr-namespace:Mars.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <!--Title="Object Amend"-->
    <UserControl.Resources>
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
        <DataTemplate x:Key="myTemplate" DataType="ValidationExample.MyData">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Division: "/>
                <TextBlock Text="{Binding Path=Division}"/>
            </StackPanel>
        </DataTemplate>

        <ControlTemplate x:Key="errorTemplate">
            <StackPanel>
                <TextBlock Foreground="Red">Invalid Value!!!</TextBlock>
                <AdornedElementPlaceholder/>
            </StackPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="TextBoxErrorTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" 
        Foreground="Orange"  FontSize="12pt">!</TextBlock>

                <Border BorderBrush="Red" BorderThickness="1">
                    <AdornedElementPlaceholder />
                </Border>
            </DockPanel>
        </ControlTemplate>

    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <!--Defined Column-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Margin="0,-3,-33,3">
                <Label x:Name="lblHeader" Content="Object Properties" FontSize="20" Margin="0,0,226,0" ></Label>
            </StackPanel>
            <!--First Column Content-->
            <Label Content="Name of Application" Grid.Column="0" Grid.Row="1" Margin="5" ></Label>
            <Label Content="Description" Grid.Column="0" Grid.Row="2" Margin="5" ></Label>

            <!--Second Column Content-->
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                <ComboBox x:Name="cbxApplication"
                  SelectedIndex="1" 
                  Grid.Column="1" 
                  Grid.Row="1"                    
                  ItemsSource="{Binding Path=RegisterdApplication}"
                  SelectedValuePath="APP_SHORT_NAME"
                  SelectedItem="{Binding SelectedApplication}"
                  Margin="4,0,295,5" Height="21" VerticalAlignment="Bottom" Width="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} v{1}">
                                        <Binding Path="APP_SHORT_NAME"/>
                                        <Binding Path="VERSION"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            
            <TextBox x:Name="Description" Grid.Column="2" Grid.Row="2" TextWrapping="Wrap"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Visible">
                <TextBox.Text>
                    <Binding Path="Description" UpdateSourceTrigger="PropertyChanged"  NotifyOnValidationError="True">
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <WrapPanel Grid.Column="2" Grid.Row="3" >
                <Button Content="Save" Width="70" Height="24" Margin="5" Command="{Binding SaveCommand}"></Button>
                <Button x:Name="btnCancel" Content="Cancel" Width="70" Height="24" Margin="5" Command="{Binding ClearCommand}"></Button>
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</mars:MarsBaseViewControl>
