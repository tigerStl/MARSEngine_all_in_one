<Window x:Class="Mars.Views.login.MarsLoginMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mars.Views.login"
        mc:Ignorable="d"
        Title="MARS Login V2.6"  Width="350"  Margin="10,5,10,5" WindowStyle="ToolWindow"         
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        Name="LoginWindow" Loaded="LoginWindow_Loaded" d:DesignHeight="434.674" PreviewKeyDown="LoginWindow_PreviewKeyDown"
        >
    <!--height = 180-->
    <Grid Margin="10,0,5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto" ></RowDefinition>
            <RowDefinition Height="auto" MaxHeight="400"></RowDefinition>
            <RowDefinition Height="auto" ></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>                    
                    <RowDefinition Height="8"></RowDefinition>
                </Grid.RowDefinitions>                
                <Image Grid.Row="0" Source="/Mars;component/Images/MARS_small_.png"   DockPanel.Dock="Left" Margin="5" Height="90" HorizontalAlignment="Left"></Image>                
                <Label Grid.Row="1" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left" FontSize="16" HorizontalAlignment="Center"/>
                <Border Grid.Row="2" Background="DarkGray" Margin="2"></Border>
            </Grid>
            
        </DockPanel>

        <Label Content="Login Name:" Grid.Row="1" Grid.Column="0" FontSize="14"></Label>
        <TextBox Text="{Binding UserName}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  Margin="15,1,5,1" FontSize="14" ></TextBox>

        <Label Content="Password:" Grid.Row="3" Margin="0,3,5,0" Grid.Column="0" FontSize="14"></Label>
        <PasswordBox  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"  Margin="15,3,5,3" Name="pwdInfo" ></PasswordBox>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,5,5" Orientation="Horizontal" FlowDirection="RightToLeft" >
            <Button FontSize="14"  Content="Login" Width="80" DockPanel.Dock="Right" Margin="3,0,3,0" Command="{Binding Path=LoginCommand}" 
                    CommandParameter="{Binding ElementName=LoginWindow}" 
                    x:Name="loginButton"></Button>
            <Button FontSize="14" Content="Option" Width="80" DockPanel.Dock="Right" Margin="3,0,3,0" Click="OptionButton_Click"></Button>
            <Button FontSize="14" Content="Cancel" Width="80" DockPanel.Dock="Right" Margin="3,0,3,0" Command="{Binding Path=CancelCommand}" 
                    CommandParameter="{Binding ElementName=LoginWindow}"
                    
                    ></Button>            
        </StackPanel>
        <DockPanel Name="dockPanelOption" Visibility="Collapsed" Grid.Row="6" Grid.Column="0"  Grid.ColumnSpan="2" LastChildFill="True"  Margin="5">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="LightGray"></Border>
                <Label FontSize="14" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontWeight="Bold" Content="Set Password for Database:" Margin="0,3,5,3"></Label>
                <Label FontSize="14" Grid.Row="2" Grid.Column="0" Content="Password"></Label>
                <Label FontSize="14" Grid.Row="3" Grid.Column="0" Content="Re-type Password"></Label>
                <PasswordBox Grid.Row="2" Grid.Column="1" Name="dbPwd"></PasswordBox>
                <PasswordBox Grid.Row="3" Grid.Column="1" Name="dbRetypePwd"></PasswordBox>
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" FlowDirection="RightToLeft"  Margin="5,5,8,5">
                    <Button Width="80" Content="OK" Command="{Binding SetDatabasePasswordCommand}" CommandParameter="{Binding ElementName=LoginWindow}"></Button>
                    <!--<Button Width="80" Content="Hide" Click="HideDatabasePwdClick" Margin="3,0,3,0"></Button>-->
                    <Button Width="80" Margin="5,0,5,0" Content="DB Test" Click="Button_Click"></Button>                 
                </StackPanel>
                
            </Grid>
           
        </DockPanel>

        <Label Grid.Row="7" Grid.Column="0"  Content="Database/Server:" Margin="5"></Label>
        <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding DatabaseConnectionItems}"
                  Margin="5" 
                  SelectedItem="{Binding CurrentDatabaseConnectionItems}"                 
                  >
            
        </ComboBox>
        <ScrollViewer Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" MaxHeight="36"
                      
                      >
            <TextBlock Text="{Binding DatabaseServerInfo}" 
                   Margin="5" TextWrapping="WrapWithOverflow" ToolTip="{Binding DatabaseServerInfo}"
                   >
            </TextBlock>
        </ScrollViewer>
        
        <Border Background="LightGray" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Height="2" Margin="5,0,5,0"></Border>
        
        <Label Height="16" Grid.Row="10" Grid.Column="0"  Grid.ColumnSpan="2" Content="© 2018 Marquis Business and Technology Solution LLC" FontSize="9" Margin="0,10,0,5" HorizontalAlignment="Center"></Label>
    </Grid>
</Window>
