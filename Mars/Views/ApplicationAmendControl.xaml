<mars:MarsBaseViewControl
    x:Class="Mars.Views.ApplicationAmendControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:Helper="clr-namespace:Mars.Helpers"
             xmlns:mars="clr-namespace:Mars.Views.baseView"

             mc:Ignorable="d">
    <!--Title="Add New Application"-->
    <UserControl.Resources>
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
    </UserControl.Resources>
    <Border BorderBrush="LightGray" CornerRadius="5"  BorderThickness="1" Margin="5,0,5,0">
        <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" Margin="4">
        
        <DockPanel LastChildFill="True">
            
        <Grid Height="auto" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto" MinHeight="96"></RowDefinition>
                <!--disable the 6th and 7th row-->
                <RowDefinition Height="Auto" MinHeight="1"></RowDefinition>
                <RowDefinition Height="Auto" MinHeight="1"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                
            </Grid.RowDefinitions>
            <!--Defined Column-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto" MinWidth="432"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <Label FontSize="20" Content="Add New Application" Height="auto" MinHeight="16" x:Name="lblTitle"></Label>
            </StackPanel>
            <!--First Column Content-->
            <Label Content="Applications" Grid.Column="0" Grid.Row="1" Margin="5" ></Label>
            <Label Content="Name of application" Grid.Column="0" Grid.Row="2" Margin="5" ></Label>
            <Label Content="Description" Grid.Column="0" Grid.Row="3" Margin="5" ></Label>
            <Label Content="Version" Grid.Column="0" Grid.Row="4" Margin="5" ></Label>
            <!--Second Column Content-->

            <TextBox Name="txtApplicationName" Grid.Column="2" Grid.Row="2" Margin="4">
                <TextBox.Text>
                    <Binding Path="ApplicationName" UpdateSourceTrigger="PropertyChanged" >
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <TextBox Name="txtApplicationDescription" Grid.Column="2" Grid.Row="3" Margin="4"
                     AcceptsReturn="True" TextWrapping="WrapWithOverflow" Height="120"
                     >
                <TextBox.Text>
                    <Binding Path="ApplicationDescription" UpdateSourceTrigger="PropertyChanged" >
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <TextBox Name="txtVersion" Grid.Column="2" Grid.Row="4" Margin="4">
                <TextBox.Text>

                    <Binding Path="Version" UpdateSourceTrigger="PropertyChanged" >

                    </Binding>
                </TextBox.Text>

            </TextBox>

            
            <ListView Name="listViewApplication" Grid.Column="2" Grid.Row="1" Margin="4" 
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                  ItemsSource="{Binding Path=RegisterdApplication}"                  
                  ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="300"
                  IsSynchronizedWithCurrentItem="True"
                  Helper:GridViewSort.AutoSort="True">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <!--
                        <GridViewColumn Header="Select" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        -->
                        <GridViewColumn Header="Application" Width="300" DisplayMemberBinding="{Binding APP_SHORT_NAME}" Helper:GridViewSort.PropertyName="APP_SHORT_NAME"/>
                        <GridViewColumn Header="Version" Width="100" DisplayMemberBinding="{Binding VERSION}" Helper:GridViewSort.PropertyName="VERSION"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <WrapPanel Grid.Column="2" Grid.Row="7" Margin="0,0,0,12" >
                <Button Content="Save" Width="70" Height="24" Margin="5" Command="{Binding SaveCommand}"/>
                <!--
                <Button Content="Delete" Width="70" Height="24" Margin="5" Command="{Binding DeleteCommand}"/>
                -->
            </WrapPanel>

            <WrapPanel Grid.Column="2" Grid.Row="8"  VerticalAlignment="Top" Grid.RowSpan="2" Margin="4,4,4,10">
                <TextBlock Name="ApplicationControlStatus" Text="{Binding ApplicationControlStatus}" FontWeight="Bold" Background="#FFF5E008" />

            </WrapPanel>
            <!--Third Column Content-->
            
            <Label Content="Extra Requirement" HorizontalAlignment="Left" Margin="5,5,0,0" Grid.Row="5" VerticalAlignment="Top" Width="103" Height="16"/>
            <ListBox x:Name="lstBoxExtraReq" 
                     Grid.Column="2" 
                     HorizontalAlignment="Left" 
                     Height="90"  
                     ItemsSource="{Binding SystemLookupList}"  
                     
                     Margin="4" 
                     Grid.Row="5" 
                     VerticalAlignment="Top" 
                     Width="484" 
                     SelectionMode="Multiple" 
                     SelectionChanged="lstBoxExtraReq_SelectionChanged"/>
            <!--
            <Label Content="Extra Popup Menu" HorizontalAlignment="Left" Margin="5,10,0,0" Grid.Row="6" VerticalAlignment="Top" Width="103" Height="16"/>
            <TextBox Name="txtExtraPopupMenu" Grid.Column="2" Grid.Row="6" Margin="4" TextChanged="txtExtraPopupMenu_TextChanged">
                <TextBox.Text>
                    <Binding Path="ExtraPopupMenu" UpdateSourceTrigger="PropertyChanged" >

                    </Binding>
                </TextBox.Text>
            </TextBox>
            -->
        </Grid>
        </DockPanel>

    </ScrollViewer>
    </Border>
</mars:MarsBaseViewControl>
