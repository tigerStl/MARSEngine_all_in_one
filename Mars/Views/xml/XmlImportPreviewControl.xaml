<mars:MarsBaseViewControl x:Class="Mars.Views.xml.XmlImportPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.Views.xml"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             mc:Ignorable="d"              
             d:DesignHeight="500" d:DesignWidth="400" >
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="30" />
            <Setter Property="SeparatorBrush" Value="LightGray" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="-1,-1,0,0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        </Style>
        <Style x:Key="GridSplitterPreviewStyle" >
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Fill="#80000000"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridSplitterVer" TargetType="{x:Type GridSplitter}">
            <Setter Property="Background"
                Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" >
                            <Canvas RenderOptions.EdgeMode="Aliased" UseLayoutRounding="True"
                                Height="16" VerticalAlignment="Center"
                                Width="7" HorizontalAlignment="Center">
                                <Line X1="0" X2="0" Y1="0" Y2="50"
                                  Stroke="White" StrokeThickness="1"/>
                                <Line X1="1" X2="1" Y1="0" Y2="50"
                                  Stroke="#A0A0A0" StrokeThickness="1"/>
                                <Line X1="4" X2="4" Y1="0" Y2="50"
                                  Stroke="White" StrokeThickness="1"/>
                                <Line X1="5" X2="5" Y1="0" Y2="50"
                                  Stroke="#A0A0A0" StrokeThickness="1"/>
                            </Canvas>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Border BorderBrush="LightGray" CornerRadius="5" Margin="5,0,5,0" BorderThickness="1">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="36"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Content="Select Import File:" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"></Label>
            <DockPanel Grid.Column="1" Grid.Row="0" LastChildFill="True">
                <Button Content=" Browse " DockPanel.Dock="Right" Margin="5" Command="{Binding BrowseXmlFile}"></Button>
                <TextBox DockPanel.Dock="Right" Margin="5,5,0,5" Text="{Binding CurrentFileName}"></TextBox>
            </DockPanel>
            <Border Grid.Column="0" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="LightGray" Margin="0,0,0,2" Grid.ColumnSpan="2"></Border>
            <Label Content="Xml information Preview:" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center"></Label>
            <DockPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="15,5,5,5" LastChildFill="True" x:Name="hostDoc" >
                <TabControl Background="White" SelectedIndex="{Binding CurrentTabItmIdx}" x:Name="MainTab">
                    <TabItem Header="Application" >
                        <ContentControl Width="{Binding Path=ActualWidth,ElementName=hostDoc}" Height="{Binding Path=ActualHeight, ElementName=hostDoc}" >
                            <Grid Margin="0,0,10,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="5"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="100"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0" Grid.Row="0"></DockPanel>
                                <Label Content="Application Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"></Label>

                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="3"
                                      ItemsSource="{Binding CurrentXmlTestCaseInfo.MarsApps}"
                                      DisplayMemberPath="APP_SHORT_NAME"
                                          SelectedItem="{Binding CurrentApplication}"
                                      ></ComboBox>
                                <Button Content="Convert to ->" Grid.Row="0" Grid.Column="2" Margin="2" Width="80" Command="{Binding ConverterToNewApplication}"></Button>
                                <ComboBox Grid.Column="3" Grid.Row="0" Margin="3" ItemsSource="{Binding AllApplications}"
                                          SelectedItem="{Binding SelectedConvertToApplication}"
                                          >
                                                                        
                                </ComboBox>
                                <Label Content="Application Description:" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Top"></Label>
                                <DockPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="3" LastChildFill="True" x:Name="HostDockPanle" Margin="3,3,3,10">
                                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="{Binding Path=ActualHeight, ElementName=HostDockPanle}" 
                                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    </TextBox>
                                </DockPanel>

                                <Label Content="Identifier:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"></Label>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="3" VerticalAlignment="Center" Text="{Binding CurrentApplication.PROCESS_IDENTIFIER}"></TextBox>

                                <Label Content="Application Version:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top"></Label>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="3" VerticalAlignment="Top" Text="{Binding CurrentApplication.VERSION}"></TextBox>

                                <Label Content="Application Type:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top"></Label>
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="3" VerticalAlignment="Top" Text="{Binding CurrentApplication.APPLICATION_TYPE_NAME}"></TextBox>
                                <Label Content="MARS Addins:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top"></Label>
                                <DockPanel Grid.Column="1" Grid.Row="4" Margin="3,3,3,10" x:Name="HostDockPanel1" >
                                    <TextBox VerticalAlignment="Top" Height="{Binding Path=ActualHeight, ElementName=HostDockPanel1}"  Text="{Binding CurrentApplication.COMMENT}" ></TextBox>
                                </DockPanel>
                            </Grid>
                        </ContentControl>
                    </TabItem>
                    <TabItem Header="Test Case">
                        <Grid Width="{Binding Path=ActualWidth,ElementName=hostDoc}" Height="{Binding Path=ActualHeight, ElementName=hostDoc}" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>

                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="5"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Row="0" Grid.Column="0" >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Test case Name" ></Label>
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="3,0,3,0" Text="{Binding CurrentXmlTestCaseInfo.TestCaseNodeInfo.TestCaseName}"></TextBox>
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Test case Description" ></Label>
                                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,3,0" Height="40" Text="{Binding CurrentXmlTestCaseInfo.TestCaseNodeInfo.TestcaseDesc}"></TextBox>
                                </Grid>
                            </DockPanel>
                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Dataset Name" ></Label>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="3,0,3,0"
                                              ItemsSource="{Binding CurrentXmlTestCaseInfo.DataSetWithSettingDataRecords}"
                                              DisplayMemberPath="DataSetName"
                                              SelectedItem="{Binding CurrentDatasetting}"></ComboBox>
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Dataset Description" ></Label>
                                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,3,0" Height="40" AcceptsReturn="True"
                                             TextWrapping="WrapWithOverflow" Text="{Binding CurrentDatasetting.Description}"></TextBox>
                                </Grid>
                            </DockPanel>
                            <DockPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" >
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"></ColumnDefinition>
                                        <ColumnDefinition Width="7"></ColumnDefinition>
                                        <ColumnDefinition MinWidth="100"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <DataGrid Grid.Row="0" Grid.Column="0" Margin="0,0,0,30" 
                                              BorderBrush="LightGray" GridLinesVisibility="All" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
                                              AutoGenerateColumns="False" CanUserAddRows="False" FrozenColumnCount="1" 
                                              IsReadOnly="True" EnableColumnVirtualization="True"
                                              ItemsSource="{Binding CurrentXmlTestCaseInfo.TestCase_Steps_For_Preview}"
                                              SelectedItem="{Binding CurrentTest_Step}"
                                              SelectionMode ="Single" SelectionUnit="FullRow"
                                              >
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Order#" Binding="{Binding Test_Step.RunOrder}"></DataGridTextColumn>
                                            <DataGridTextColumn Header="Keyword" Binding="{Binding Test_Step.Keyword}"></DataGridTextColumn>
                                            <DataGridTextColumn Header="Object" Binding="{Binding Test_Step.ObjectName}"></DataGridTextColumn>
                                            <DataGridTextColumn Header="Parameter" Binding="{Binding Test_Step.StepsParamenter}"></DataGridTextColumn>
                                            <DataGridTextColumn Header="Data" Binding="{Binding Test_Data.DataValue}"></DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DockPanel Grid.Column="2" Grid.Row="0" Margin="0,0,10,30">
                                        <Grid >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="auto"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"></GridSplitter>
                                            <Label Content="Application Information" Grid.Row="0" Margin="3,0,3,0"></Label>
                                            <ComboBox Grid.Row="1" Margin="3,0,3,0"
                                                      ItemsSource="{Binding CurrentXmlTestCaseInfo.MarsApps}"
                                                      DisplayMemberPath="APP_SHORT_NAME"
                                                      SelectedItem="{Binding CurrenTestCaseApplication}"
                                                      ></ComboBox>
                                            <Label Content="Object Information" Grid.Row="2"></Label>
                                            <TextBox Grid.Row="3" Margin="3,0,3,0" Text="{Binding CurrentObjIdentifier}"></TextBox>
                                        </Grid>
                                    </DockPanel>


                                </Grid>
                            </DockPanel>
                        </Grid>

                    </TabItem>
                    <TabItem Header="Create Import Envelop">
                        <Grid Width="{Binding Path=ActualWidth,ElementName=hostDoc}" Height="{Binding Path=ActualHeight, ElementName=hostDoc}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                
                            </Grid.ColumnDefinitions>
                            <Label Content="Envelop For Import:" Grid.Row="0" Grid.ColumnSpan="2" Margin="3"></Label>
                            <Button Content="Save" Grid.Row="0" Grid.Column="2" Width="40" Height="auto" Margin="3,3,20,3" HorizontalAlignment="Left"
                                    Command="{Binding SaveEnvelopCommand}"
                                    
                                    ></Button>
                            <DataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,3,3"
                                      ItemsSource="{Binding Envelop_applications}"
                                      CanUserAddRows="True"
              AutoGenerateColumns="False"
                                      >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Imported Application Name"
                                                        Binding="{Binding ApplicationNameFromXml}"
                                                        >
                                        
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Map To"
                                                        Binding="{Binding MapTo}"
                                                        >                                        
                                    </DataGridTextColumn>
                                    <DataGridCheckBoxColumn Header="Skip Import"
                                                        Binding="{Binding IsSkipImport}"    
                                                            ></DataGridCheckBoxColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                        </Grid>
                    </TabItem>
                    <!--
                    <TabItem Header="Log&amp;Report">
                        <Grid Width="{Binding Path=ActualWidth,ElementName=hostDoc}" Height="{Binding Path=ActualHeight, ElementName=hostDoc}" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="5"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="MARS Test Case Import Log&amp;Report:" Grid.Row="0"></Label>
                            <ListBox Grid.Row="1" Margin="13,3,10,30" ItemsSource="{Binding ImportLogList}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionChanged="ListBox_SelectionChanged"
                                     >
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Log}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    -->
                </TabControl>

            </DockPanel>
            <DockPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1"  Width="100" Content="Import" Margin="0,3,5,3" Command="{Binding ImportXmlToDB}" Click="Button_Click"></Button>
                </Grid>

            </DockPanel>
        </Grid>
    </Border>
</mars:MarsBaseViewControl>
