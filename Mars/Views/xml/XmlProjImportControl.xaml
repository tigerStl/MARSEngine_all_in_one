<mars:MarsBaseViewControl x:Class="Mars.Views.xml.XmlProjImportControlxaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.Views.xml"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
                          xmlns:md="clr-namespace:Mars.xml.importExport.xmlnodes"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Select File:" Margin="3,3,10,3"></Label>
            <TextBox MinWidth="100" Margin="0,3,10,3" MaxWidth="1000" Text="{Binding CurrentDirectoryOfProjectFiles}"></TextBox>
            <Button MinWidth="50" Margin="3,3,10,3" Content="  Load Files  " Command="{Binding LoadProjectsFilesClickCommand}"></Button>
        </StackPanel>
        <TabControl Grid.Row="2" x:Name="hostTab" >
            <TabItem Header="Infomation">
                <ContentControl Width="{Binding Path=ActualWidth,ElementName=hostTab}" Height="{Binding Path=ActualHeight, ElementName=hostTab}" Margin="3,0,10,10">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"></RowDefinition>
                            <RowDefinition MaxHeight="120"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="20"></ColumnDefinition>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            
                        </Grid.ColumnDefinitions>
                        <Label Content="Project Name:" Grid.Row="0" Grid.Column="0"></Label>
                        <Label Content="Project Description:" Grid.Row="1" Grid.Column="0" Background="LightGray"></Label>
                        <Label Content="Applications:" Grid.Row="0" Grid.Column="3"></Label>
                        
                        <Label Content="{Binding ProjectXmlFile.ProjectName}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"></Label>
                        <TextBlock Text="{Binding ProjectXmlFile.ProjectDesc}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="LightGray" Margin="3"></TextBlock>
                        <ListBox Grid.Row="1" Grid.Column="3" MinWidth="100" Margin="5,3,18,3" 
                                 ItemsSource="{Binding ProjectXmlFile.AssignedApplications}" 
                                 Background="LightGray"
                                 >
                            
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type md:MarsProjExpAppInfo}" >
                                    
                                    <Label Content="{Binding ApplicationName}"></Label>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <Label Content="Log:" Grid.Row="2" Grid.Column="0" ></Label>
                        <ListBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="2,2,20,40" x:Name="LoadInformationLogList" 
                                 SelectedItem="{Binding LastLoadLog}"                                 
                                 ItemsSource="{Binding CurrentLog}"></ListBox>
                        
                    </Grid>
                </ContentControl>
            </TabItem>
            <TabItem Header="StoryBoard List" Name="tabDynamicHost" >
                <ContentControl >
                    <TabControl Name="tabDynamic" ItemsSource="{Binding ProjectXmlFile.AssignedStoryboards}" Background="White" 
                                
                                >
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type md:MarsProjExpStoryboardInfo}">
                                <DockPanel>                                    
                                    <TextBlock Text="{Binding StoryboardName}" />
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type md:MarsProjExpStoryboardInfo}"                                          
                                          >
                                <StackPanel Width="{Binding Path=ActualWidth,ElementName=tabDynamic}" Height="{Binding Path=ActualHeight, ElementName=tabDynamic}" 
                                            Margin="5,5,20,5"
                                            >
                                    <!--#region test storyboard DataGrid-->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                            <RowDefinition Height="5"></RowDefinition>

                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Test Story board Detail:" Grid.Row="0" Grid.Column="0"></Label>
                                        <TextBox AcceptsReturn="True" MaxLines="5" Text="{Binding StoryboardDesc}" Grid.Row="0" Grid.Column="1" Margin="5,5,40,5"
                                                 Height="80" IsReadOnly="True" Background="LightGray"> </TextBox>
                                        <DataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                              ItemsSource="{Binding StoryboardDetailListForExp}"
                                              CanUserAddRows="False"
                                              AutoGenerateColumns="False"
                                                  Margin="5,5,40,5"
                                                  IsReadOnly="True" Background="LightGray"
                                              >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding RunOrder}" ></DataGridTextColumn>
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}"></DataGridTextColumn>
                                                <DataGridTextColumn Header="Test Suite Name" Binding="{Binding TS_Name}"></DataGridTextColumn>
                                                <DataGridTextColumn Header="Test Case Name" Binding="{Binding TCName}"></DataGridTextColumn>
                                                <DataGridTextColumn Header="Alias" Binding="{Binding AliaseName}"></DataGridTextColumn>
                                                <DataGridTextColumn Header="Dataset Name" Binding="{Binding DSName}"></DataGridTextColumn>
                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </Grid>
                                </StackPanel>
                                <!--#endregion-->
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </ContentControl>
            </TabItem>
            <TabItem Header="Test Suites">
                <ContentControl  
                    Width="{Binding Path=ActualWidth, ElementName=hostTab}" 
                                Height="{Binding Path=ActualHeight,ElementName=hostTab}"
                                Name="TestSuiteFirstLvl"
                                Margin="-1,0,-1,0">
                    <!--
                    {Binding Path=PathToProperty,
    RelativeSource={RelativeSource AncestorType={x:Type typeOfAncestor}}}
                    -->
                    <TabControl ItemsSource="{Binding ProjectXmlFile.AssignedTestSuites}" Name="tabTestSuite" 
                                Width="{Binding Path=ActualWidth, ElementName=TestSuiteFirstLvl}" 
                                Height="{Binding Path=ActualHeight,ElementName=TestSuiteFirstLvl}"
                                Margin="-1,0,-1,0"
                                >
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type md:MarsProjExpTestSuiteInfo}">
                                <Label Content="{Binding TestSuiteName}"></Label>                                
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type md:MarsProjExpTestSuiteInfo}">
                                <Grid 
                                      x:Name="grdHostTestSuite"
                                      Width="{Binding Path=ActualWidth, ElementName=tabTestSuite}" 
                                Height="{Binding Path=ActualHeight,ElementName=tabTestSuite}"
                                Margin="-1,0,-1,0"
                                            >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100"></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition Height="10"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Description:" Grid.Row="0" Grid.Column="0" Margin="5"></Label>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TestSuiteDescription}" Background="LightGray" Margin="5"></TextBlock>
                                    <TabControl 
                                        Width="{Binding Path=ActualWidth,ElementName=grdHostTestSuite}"
                                        Height="{Binding Path=ActualHeight,ElementName=grdHostTestSuite}"
                                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Margin="1"
                                        Name="testCaseTab"
                                        ItemsSource="{Binding ChildTestCases}">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type md:TestCaseExportXmlNodes}">
                                                <Label Content="{Binding TestCaseNodeInfo.TestCaseName}"></Label>
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate DataType="{x:Type md:TestCaseExportXmlNodes}">
                                                <Grid Width="{Binding Path=ActualWidth,ElementName=testCaseTab}"
                                                           Height="{Binding Path=ActualHeight,ElementName=testCaseTab}"
                                                           Margin="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="100"></RowDefinition>
                                                        <RowDefinition Height="auto"></RowDefinition>
                                                        <RowDefinition Height="*"></RowDefinition>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                                        <ColumnDefinition Width="10"></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Margin="5" Content="Test Case Description:" Grid.Row="0" Grid.Column="0"></Label>
                                                    <TextBlock Margin="5" Text="{Binding TestCaseNodeInfo.TestcaseDesc}"  Grid.Row="0" Grid.Column="1" Background="LightGray" IsEnabled="False" TextWrapping="Wrap" ></TextBlock>
                                                    <Label Margin="5" Content="Test Case Description:" Grid.Row="1" Grid.Column="0"></Label>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight">
                                                    <ComboBox ItemsSource="{Binding DataSetWithSettingDataRecords}" DisplayMemberPath="DataSetName" MaxWidth="400" 
                                                              SelectedItem="{Binding CurrentDataSet, Mode=TwoWay}"
                                                              ></ComboBox>
                                                    </StackPanel>
                                                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False"
                                                                      Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                              ItemsSource="{Binding TestSteps}"
                                                              Margin="5,5,16,200"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                              IsReadOnly="True"
                                                              
                                                              >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="#" Binding="{Binding RunOrder}"></DataGridTextColumn>
                                                            <DataGridTextColumn Header="Key Word" Binding="{Binding Keyword}"></DataGridTextColumn>
                                                            <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}"></DataGridTextColumn>
                                                            <DataGridTextColumn Header="Parameters" Binding="{Binding StepsParamenter}"></DataGridTextColumn>
                                                            <DataGridTextColumn Header="Data" Binding="{Binding CurrentData}"></DataGridTextColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>

                                                </Grid>

                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>
                                </Grid>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </ContentControl>
            </TabItem>
            <!--<TabItem Header="Test Cases">
                <ContentControl Width="{Binding Path=ActualWidth,ElementName=hostTab}" Height="{Binding Path=ActualHeight, ElementName=hostTab}" Margin="3,0,10,10">
                </ContentControl>
            </TabItem>-->
        </TabControl>
        <StackPanel Grid.Row="3" FlowDirection="RightToLeft" Orientation="Horizontal">
            <Button Content="Import" Width="80" Margin="5" Command="{Binding ImportProjectFileToDBCommand}"></Button>
        </StackPanel>
    </Grid>
</mars:MarsBaseViewControl>
