<mars:MarsBaseViewControl x:Class="Mars.Views.TestVarDatabaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:v="clr-namespace:Mars.Views"
             xmlns:Helper="clr-namespace:Mars.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>

        <con:BaseCompConverter x:Key="BaseCompConverter" />

        <!--
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
        <DataTemplate x:Key="myTemplate" DataType="ValidationExample.MyData">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Division: "/>
                <TextBlock Text="{Binding Path=Division}"/>
            </StackPanel>
        </DataTemplate>
-->
        <Style x:Key="GridSplitterPreviewStyle" >
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Fill="#80000000"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="errorTemplate">
            <StackPanel>
                <TextBlock Foreground="Red">Invalid Value!!!</TextBlock>
                <AdornedElementPlaceholder/>
            </StackPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="TextBoxErrorTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" 
        Foreground="Orange"  FontSize="12pt">!</TextBlock>

                <Border BorderBrush="Red" BorderThickness="1">
                    <AdornedElementPlaceholder />
                </Border>
            </DockPanel>
        </ControlTemplate>

        <Style x:Key="GridSplitterVer" TargetType="{x:Type GridSplitter}">
            <Setter Property="Background"
                Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" >
                            <Canvas RenderOptions.EdgeMode="Aliased" UseLayoutRounding="True"
                                Height="16" VerticalAlignment="Center"
                                Width="7" HorizontalAlignment="Center">
                                <Line X1="0" X2="0" Y1="0" Y2="50"
                                  Stroke="White" StrokeThickness="1"/>
                                <Line X1="1" X2="1" Y1="0" Y2="50"
                                  Stroke="#A0A0A0" StrokeThickness="1"/>
                                <Line X1="4" X2="4" Y1="0" Y2="50"
                                  Stroke="White" StrokeThickness="1"/>
                                <Line X1="5" X2="5" Y1="0" Y2="50"
                                  Stroke="#A0A0A0" StrokeThickness="1"/>
                            </Canvas>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>

        </Grid.RowDefinitions>
        <!--Defined Column-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1"  Margin="3">
            <Label x:Name="lblHeader" Content="Test Variable List" FontSize="20" Margin="0,0,0,0" ></Label>

        </StackPanel>
        <Button Grid.Row="0" Grid.Column="1" Width="60"  HorizontalAlignment="Right" Click="Button_Click" Margin="5,1,5,1" ToolTip="Re-fetch ALL objects from database" >Refresh</Button>
        <GroupBox Header="Variable Filters" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="0,5,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="50"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>                    
                </Grid.ColumnDefinitions>
                
                
                <!--First Column Content-->

                <Label Content="Name" Grid.Column="0" Grid.Row="0" Margin="3" ></Label>
                <TextBox Grid.Column="1" Grid.Row="0" Margin="3"  Name="txtFilter" 
                 TextChanged="txtFilter_TextChanged" />

                <Label Content="Type" Grid.Column="2" Grid.Row="0" Margin="3" ></Label>
                <!--
                <TextBox Grid.Column="3" Grid.Row="0" Margin="3"  Name="txtTypeFilter" 
                 TextChanged="typeFilter_TextChanged" />
                -->
                <ComboBox Grid.Row="0" Grid.Column="3" SelectionChanged="typeFilter_TextChanged" >
                    <ComboBoxItem Name="All" Content="(All)"></ComboBoxItem>
                    <ComboBoxItem Name="GLOBAL_VAR" Content="Global Var"></ComboBoxItem>
                    <ComboBoxItem Name="LOCAL_VAR" Content="Local Var"></ComboBoxItem>
                    <ComboBoxItem Name="LOOP_VAR" Content="Loop Var"></ComboBoxItem>
                    <ComboBoxItem Name="MODAL_VAR" Content="Modal Var"></ComboBoxItem>
                </ComboBox>
            </Grid>
        </GroupBox>
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="7"></ColumnDefinition>
                <ColumnDefinition Width="1*" MinWidth="300"></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" LastChildFill="True"  >
                <ListView Name="listViewSystemLookup" 
                      ItemsSource="{Binding SystemLookup}" 
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.IsVirtualizing="False"
                      SelectionMode="Single" 
                      SelectedItem="{Binding SelectedVar,UpdateSourceTrigger=PropertyChanged}"
                      DockPanel.Dock="Left"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      HorizontalAlignment="Stretch"                
                      VerticalAlignment="Stretch"
					  Helper:GridViewSort.AutoSort="True"
                      Margin="2,0,8,0"
                      >


                    <!--AF
                    
                    -->
                    <ListView.Resources>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" 
                                            Width="Auto" 
                                            DisplayMemberBinding="{Binding FIELD_NAME}" 
                                            Helper:GridViewSort.PropertyName="FIELD_NAME">
                            </GridViewColumn>
                            <GridViewColumn Header="Value"
                                            Width="Auto" 
                                            DisplayMemberBinding="{Binding DISPLAY_NAME}"
                                            Helper:GridViewSort.PropertyName="DISPLAY_NAME"/>

                            <GridViewColumn Header="Type" 
                                            Width="Auto" 
                                            DisplayMemberBinding="{Binding TABLE_NAME}" 
                                            Helper:GridViewSort.PropertyName="TABLE_NAME"/>

                            <GridViewColumn Header="Base/Comp" 
                                            Width="Auto" 
                                            DisplayMemberBinding="{Binding CurrentStatus, Converter={StaticResource BaseCompConverter}}" 
                                            Helper:GridViewSort.PropertyName="STATUS"/>

                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem 
                                Command="{Binding ExportToExcelCommand}" 
                                CommandParameter="{Binding PlacementTarget.ItemsSource, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="Export To Excel" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </DockPanel>

            <GridSplitter   ResizeDirection="Columns"  Grid.Row="0" Grid.Column="1" 
                  VerticalAlignment="Stretch"  Width="7" 
                  BorderBrush="LightGray" BorderThickness="1"    
                  Style="{DynamicResource GridSplitterVer}"
                      />
            <DockPanel Grid.Column="2" Grid.Row="0"  LastChildFill="True" Width="auto" >



                <!--<v:ObjectsEditControl DataContext="{Binding SelectedObject}" x:Name="objectEdit" Width="auto" MinWidth="300"></v:ObjectsEditControl>-->
                <v:TestVarEditControl DataContext="{Binding SelectedVar}" x:Name="varEdit" Width="auto" MinWidth="300"></v:TestVarEditControl>

            </DockPanel>
        </Grid>
    </Grid>

</mars:MarsBaseViewControl>
