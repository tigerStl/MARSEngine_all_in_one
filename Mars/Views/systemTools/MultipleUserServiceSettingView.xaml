<mars:MarsBaseViewControl x:Class="Mars.Views.systemTools.MultipleUserServiceSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.Views.systemTools"
                     xmlns:mars="clr-namespace:Mars.Views.baseView"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="auto" MinWidth="400"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Content="MARS User WCF Services Setting:" FontWeight="Bold" Margin="5"></Label>
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" MaxWidth="800"></ColumnDefinition>
                    <ColumnDefinition MinWidth="100" MaxWidth="200" ></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Content="Current Services List:"></Label>
                <ListBox Grid.Row="1" Grid.Column="0"  Margin="5" Grid.RowSpan="6" 
                         ItemsSource="{Binding CurrentServicesInfo,Mode=TwoWay}"
                         SelectedItem="{Binding SelectedServiceInfo, Mode=TwoWay}"
                         SelectionMode="Single"
                         >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Account: "></Label>
                                <Label Content="{Binding AccountName}"></Label>
                                <Label Content="  Port: "></Label>
                                <Label Content="{Binding ServerPort}" Foreground="Green"></Label>
                                <Label Content="-"></Label>
                                <Label Content="{Binding MonitorPort}" Foreground="Green"></Label>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Label Grid.Row="1" Grid.Column="1"  Content="Account:"></Label>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedServiceInfo.AccountName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></TextBox>
                <Label Grid.Row="3" Grid.Column="1"  Content="Port Number:"></Label>
                <TextBox Grid.Row="4" Grid.Column="1"  Text="{Binding SelectedServiceInfo.ServerPort,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></TextBox>
                <Label Grid.Row="5" Grid.Column="1"  Content="Monitor Port Number:"></Label>
                <TextBox Grid.Row="6" Grid.Column="1"  Text="{Binding SelectedServiceInfo.MonitorPort,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></TextBox>
            </Grid>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Height="auto">
            <Button Content="Delete" Margin="5" Width="80" Command="{Binding DeleteCurrentNodeInfo}"></Button>
            <Button Content="Create New" Margin="5" Width="80" Command="{Binding CreateNodeInfo}"></Button>
            <Button Content="Save" Margin="5" Width="80" Command="{Binding SaveNodesInfo}"></Button>
        </StackPanel>
    </Grid>
</mars:MarsBaseViewControl>
