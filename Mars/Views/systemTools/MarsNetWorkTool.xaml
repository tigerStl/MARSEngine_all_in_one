<mars:MarsBaseViewControl x:Class="Mars.Views.systemTools.MarsNetWorkTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.Views"    
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             xmlns:marstools="clr-namespace:Mars.Views.systemTools"
                          mars:Title="MARS DB/Network Tools"
                          
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="500">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="5"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="MARS Network/Database Diagnosis:" FontWeight="DemiBold" FontSize="13" x:Name="lblTitle"></Label>
        <TabControl Grid.Row="1" Grid.Column="0" x:Name="hostTab" IsSynchronizedWithCurrentItem="True" >
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid Name="Panel">
                                    <ContentPresenter x:Name="ContentSite"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                ContentSource="Header"
                                Margin="10,2"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Panel" Property="Background" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="Panel" Property="Background" Value="LightGray" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Database Connections">
                <DockPanel >
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="148*"></ColumnDefinition>
                            <ColumnDefinition Width="97*"/>
                        </Grid.ColumnDefinitions>
                        <TabControl Grid.Row="0" Grid.ColumnSpan="2">
                            <TabItem Header="Oracle">
                                <marstools:OracleConnectionSettings x:Name="OracleConnectionGui"  Margin="5"></marstools:OracleConnectionSettings>
                            </TabItem>
                            <TabItem Header="SQL Server">
                                <marstools:SQLServerConnectionSetting Margin="5"></marstools:SQLServerConnectionSetting>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Network Diagnosis" >
                <ContentControl Width="{Binding Path=ActualWidth,ElementName=hostTab}" Height="{Binding Path=ActualHeight, ElementName=hostTab}" Margin="3,0,10,10">
                    <Grid Margin="3,0,20,50">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Content="HostName/IP:" Grid.Row="0" Grid.Column="0"></Label>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="3" x:Name="edtMachineName"></TextBox>
                        <Label Content=" Port:" Grid.Row="0" Grid.Column="2"></Label>
                        <TextBox Grid.Row="0" Grid.Column="3" Width="40" HorizontalAlignment="Left" Margin="3" x:Name="edtPort"></TextBox>
                        <Button Content="Connect" Grid.Column="3" Grid.Row="0" Margin="50,3,3,3" HorizontalAlignment="Left" Width="100" Click="TestButtonClick"></Button>
                        <Label Content="Command:" Grid.Column="0" Grid.Row="1"></Label>
                        <TextBox Grid.Column="1" Grid.Row="1" Margin="3" x:Name="edtCmmd"></TextBox>


                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1"></Border>

                        <StackPanel Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2"   Orientation="Horizontal" >
                            <Button Content="Test Command" Width="100" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="3" Click="SendCommand"></Button>
                            <Button Content="Clear" Width="100" HorizontalAlignment="Left" Margin="3" Click="ClearLog"></Button>
                            <Button Content="RunCommand" Width="100" HorizontalAlignment="Left" Margin="3" Click="RunACommand"></Button>
                        </StackPanel>
                        <Label Content="Trace Log:" Grid.Row="2" Grid.Column="0"></Label>
                        <TextBox Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="2" Margin="3" TextWrapping="WrapWithOverflow" x:Name="txtLog"></TextBox>
                    </Grid>
                </ContentControl>
            </TabItem>
            <TabItem Header="Table Tools">
                <ContentControl>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="10"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Content="Input Sql/Table Name below:" Margin="5" Grid.Row="0" Grid.Column="0"></Label>
                        <DockPanel Grid.Row="0" Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions    >
                                    <RowDefinition Height="*"></RowDefinition>

                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TestQueryInfo" Margin="5" Grid.Row="0" Grid.Column="0" TextWrapping="WrapWithOverflow"></TextBox>
                                <Button Content="Do" Grid.Row="0" Grid.Column="1" Click="DoButton_Click_1"></Button>
                            </Grid>
                        </DockPanel>
                        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" LastChildFill="True" >
                            <Border BorderBrush="LightBlue" BorderThickness="2" CornerRadius="5" >
                                <ScrollViewer>
                            <TextBlock x:Name="QueryResultText" Text="{Binding CurrentSqlOrTableSummary}" ScrollViewer.VerticalScrollBarVisibility="Visible"
                                       ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                       Margin="6"
                                       ></TextBlock>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Grid>
                </ContentControl>
            </TabItem>
        </TabControl>

    </Grid>
</mars:MarsBaseViewControl>
