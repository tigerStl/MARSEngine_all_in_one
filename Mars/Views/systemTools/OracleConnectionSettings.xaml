<UserControl x:Class="Mars.Views.systemTools.OracleConnectionSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.Views.systemTools"
             
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500">
    <Grid>
        
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="Select Connection:" Margin="3" VerticalAlignment="Center"></Label>
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="120" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="5,3,5,3" VerticalAlignment="Center" x:Name="connectTypeDropList">
                <ComboBoxItem>Use TNS Name</ComboBoxItem>
                <ComboBoxItem>Use TNS String</ComboBoxItem>
                <ComboBoxItem>Use Entity Framework</ComboBoxItem>
            </ComboBox>
            <Label Content="Connection Info:" Grid.Column="0" Grid.Row="1" Margin="3" VerticalAlignment="Center"></Label>
            <TextBox Grid.Column="1" Grid.Row="1" Margin="5" Grid.RowSpan="3" x:Name="edtConnectionDBInfo" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"></TextBox>

            <Label Content="DB UserName:" Grid.Column="2" Grid.Row="1" Margin="3" VerticalAlignment="Center"></Label>
            <TextBox Grid.Column="3" Grid.Row="1" Margin="5" x:Name="txtDBUserName"></TextBox>
            <Label Content="DB Password:" Grid.Column="2" Grid.Row="2" Margin="3" VerticalAlignment="Center"></Label>
            <TextBox Grid.Column="3" Grid.Row="2" Margin="5" x:Name="txtPassword"></TextBox>
            <Label Content="Trace:" Grid.Column="2" Grid.Row="3" Margin="3" VerticalAlignment="Top"></Label>
            <TextBox Grid.Column="3" Grid.Row="3" Margin="5" x:Name="txtDBLog" MinHeight="120"></TextBox>
            <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" LastChildFill="False" Margin="0,0,5,0">
                <Button Content="Set as Default" Width="100" Height="30" DockPanel.Dock="Right" Click="ClickSaveDBConnectionType"></Button>
                <Button Content="Test Connection" Width="100" Height="30" DockPanel.Dock="Right" Margin="5,0,10,0" Click="ClickTestDBConnection"></Button>
            </DockPanel>


    </Grid>
</UserControl>
