<mars:MarsBaseViewControl x:Class="Mars.Views.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local ="clr-namespace:Mars.ViewModel"
             xmlns:control="clr-namespace:MultiSelectComboBox;assembly=MultiSelectComboBox"
             xmlns:l="clr-namespace:Mars.Converter"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             
               xmlns:Helper="clr-namespace:Mars.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="249" d:DesignWidth="500" 
             
             >
    <!--Title="Dashboard"-->
    <UserControl.Background>
        <LinearGradientBrush  SpreadMethod="Reflect" StartPoint="0 0" EndPoint="0 0.08">
            <GradientStop Offset="0.5" Color="#FFDFF0F0"/>
            <GradientStop Offset="0.5" Color="#FFE2F5F5"/>
        </LinearGradientBrush>

    </UserControl.Background>

    <UserControl.Resources>
        <l:StringConverter x:Key="Convert" />
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="30" />
            <Setter Property="SeparatorBrush" Value="LightBlue" />
            <Setter Property="FontWeight" Value="Black" />

            <Setter Property="BorderThickness" Value="1,1,1,1"/>
        </Style>

        <LinearGradientBrush x:Key="passedButtonStyleGradient"  StartPoint="0.5,0" EndPoint="1,0" SpreadMethod="Reflect">
            <GradientStop Color="#FF4A814A" Offset="1"/>
            <GradientStop Color="#FFA4DE69" Offset="0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="failedBbuttonStyleGradient"  StartPoint="0.5,0" EndPoint="1,0" SpreadMethod="Reflect">
            <GradientStop Color="#FF9B4228" Offset="1"/>
            <GradientStop Color="#FFF17B7B" Offset="0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="inProgressButtonStyleGradient"  StartPoint="0.5,0" EndPoint="1,0" SpreadMethod="Reflect">
            <GradientStop Color="#FFBBA128" Offset="1"/>
            <GradientStop Color="#FFE8CD5A" Offset="0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="bgStyleGradient" SpreadMethod="Reflect" StartPoint="0 0" EndPoint="0 0.08">
            <GradientStop Offset="0.5" Color="#FFDFF0F0"/>
            <GradientStop Offset="0.5" Color="#FFE2F5F5"/>
        </LinearGradientBrush>

         <Style x:Key="buttonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Vrinda"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource passedButtonStyleGradient}" />
        </Style>


        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Blue" />
            <Setter Property="BorderBrush" Value="White" />

        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        
        <ControlTemplate x:Key="TextBoxErrorTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" 
        Foreground="Orange"  FontSize="12pt">!</TextBlock>

                <Border BorderBrush="Red" BorderThickness="1">
                    <AdornedElementPlaceholder />
                </Border>
            </DockPanel>
        </ControlTemplate>

    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Height="22" Margin="0,2,0,0" Orientation="Horizontal">

                <Label x:Name="lblHeader" FontSize="18" FontWeight ="Black" Content="{Binding Title}"   Margin="5,0,0,0" Height="20"  />
                <Label x:Name="lblHeader2" FontSize="15" FontWeight ="Black" Content="                "  Margin="5,0,0,0" Height="20"  />
                <Label x:Name="lblPassed" FontSize="15" FontWeight ="Black" Content="Passed:"  Margin="5,0,0,0" Height="20"  />
                <Rectangle Width="15" 
                        
                        Fill="{StaticResource passedButtonStyleGradient}"
                        Height="15" 
                        VerticalAlignment="Bottom"
                        Margin="10,1,0,0"  AllowDrop="False">
                   
                </Rectangle>
                <Label x:Name="lblFailed" FontSize="15" FontWeight ="Black" Content="     Failed:   "  Margin="5,0,0,0" Height="20"  />
                <Rectangle Width="15"   
                        Height="15"
                        Fill= "{StaticResource failedBbuttonStyleGradient}" 
                        VerticalAlignment="Bottom"
                        Margin="0,1,0,0"  />
                <Label x:Name="lblNotProcessed" FontSize="15" FontWeight ="Black" Content="     Not Processed:   "  Margin="5,0,0,0" Height="20"  />
                <Rectangle Width="15" 
                        Height="15"
                        Fill = "{StaticResource inProgressButtonStyleGradient}"  
                        VerticalAlignment="Bottom"
                        Margin="0,1,10,0" />
            </StackPanel>
            <DataGrid x:Name="dashboardGrid" RowHeaderWidth="0"  
                      Margin="0,2,0,0" 
                      Grid.Row="1" Grid.Column="0"  
                      ItemsSource="{Binding DashboardDataColl}" 
                      AutoGenerateColumns="False"
        		      CanUserDeleteRows="False"  
                      SelectedItem="{Binding SelectedDashboardData}" 
                      IsReadOnly="True"
                      VerticalAlignment="Top"
                      VerticalGridLinesBrush="LightGray" 
                      HorizontalGridLinesBrush="LightGray" MouseDoubleClick="dashboardGrid_MouseDoubleClick"
                      Background="#FFDFF0F0"
                      >
             
                
                <DataGrid.Resources>
                    <Style x:Key="DataGridBase" TargetType="Control">
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <TransformGroup>
                                    <RotateTransform Angle="-90" />
                                    <ScaleTransform ScaleX="1" ScaleY="-1" />
                                </TransformGroup>
                            </Setter.Value>
                        </Setter>
                        
                        <Setter Property="Background" Value="{StaticResource bgStyleGradient}"/>
                        
                        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="FontSize" Value="20" />
                        <Setter Property="Foreground" Value="Gray" />
                        <Setter Property="Margin" Value="5" />
                    </Style >
                    
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridBase}" />
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridBase}"/>
                    <Style TargetType="DataGridRowHeader" BasedOn="{StaticResource DataGridBase}"/>
                 
                    
                </DataGrid.Resources>

                <DataGrid.LayoutTransform>
                    <TransformGroup>
                        <RotateTransform Angle="90" />
                        <MatrixTransform Matrix="-1, 0, 0, 1, 0, 0" />
                    </TransformGroup>
                </DataGrid.LayoutTransform>

                
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFE2F5F5"/>
                    </Style>
                </DataGrid.RowStyle>
                
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="userControlColumn" Width="480">
                        <DataGridTemplateColumn.HeaderTemplate >
                            <DataTemplate x:Name="dataTemplate">
                                <StackPanel x:Name="ScalePanel"  
                                    Orientation="Vertical" 
                                            HorizontalAlignment="Stretch"  
                                            VerticalAlignment="Stretch"
                                            
                                             Width="100"
                                             Height="470"
                                            Margin="100,0,0,0"
                                            
                                             >
                                    <Label x:Name="dblbl10" Content="100%"  HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl9" Content="90%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl8" Content="80%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl7" Content="70%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl6" Content="60%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl5" Content="50%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl4" Content="40%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl3" Content="30%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl2" Content="20%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                    <Label x:Name="dblbl1" Content="10%"    HorizontalAlignment="Right"  VerticalAlignment="Top" FontSize="15" Margin="0,0,0,26" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4">
                                    
                                        <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Stretch"  
                                            VerticalAlignment="Stretch"
                                            Background="{StaticResource bgStyleGradient}"
                                            >
                                            <Button Width="40" 
                                                   
                                                    ToolTip="{Binding PassedTag}"
                                                    Style="{StaticResource buttonStyle}" Background="{StaticResource passedButtonStyleGradient}"
                                                    Height="{Binding PassedHeight}" 
                                                    VerticalAlignment="Bottom"
                                                    BorderThickness="0"
                                                    Margin="10,1,0,0" FontWeight="Bold" FontSize="16" AllowDrop="False"/>
                                            <Button Width="40" 
                                                    
                                                    ToolTip="{Binding FailedTag}"
                                                     Style="{StaticResource buttonStyle}" Background="{StaticResource failedBbuttonStyleGradient}"
                                                    Height="{Binding FailedHeight}" 
                                                    VerticalAlignment="Bottom"
                                                    BorderThickness="0"
                                                    Margin="0,1,0,0" FontWeight="Bold" FontSize="16"/>
                                            <Button Width="40" 
                                                
                                                ToolTip="{Binding InprocessTag}"
                                                 Style="{StaticResource buttonStyle}" Background="{StaticResource inProgressButtonStyleGradient}"
                                                Height="{Binding InProcessHeight}"  
                                                VerticalAlignment="Bottom"
                                                    BorderThickness="0"
                                                Margin="0,1,10,0" FontWeight="Bold" FontSize="16"/>             
                                        </StackPanel>
                                   
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Storyboard" 
                                        Width="Auto" 
                                        Binding="{Binding StoryboardName, UpdateSourceTrigger=PropertyChanged}" MinWidth="30">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn >

                    <DataGridTextColumn Header="Total Test Cases" 
                                        Width="Auto" 
                                        Binding="{Binding TotalTestCaseCount, UpdateSourceTrigger=PropertyChanged}" 
                                        >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn >
                    
                    <DataGridTextColumn Header="Passed Test Cases" 
                                        Width="Auto" 
                                        Binding="{Binding PassedCount, UpdateSourceTrigger=PropertyChanged}" 
                                        >
                               <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn >
               

                    <DataGridTextColumn Header="Failed Test Cases" 
                                        Width="Auto" 
                                        Binding="{Binding FailedCount, UpdateSourceTrigger=PropertyChanged}" 
                                        >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn >

                    <DataGridTextColumn Header="Not Processed Test Cases" 
                                        Width="Auto" 
                                        Binding="{Binding InProcessCount, UpdateSourceTrigger=PropertyChanged}" 
                                        >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn >
                    

                    <DataGridTextColumn Header="Last Run Date" 
                                        Width="Auto" 
                                        Binding="{Binding LastRunDate, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn >

                    <DataGridTextColumn Header="Last Run Time" 
                                        Width="Auto" 
                                        Binding="{Binding LastRunTime, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn >

                </DataGrid.Columns>
                
            </DataGrid>
         
        </Grid>
    </ScrollViewer>
</mars:MarsBaseViewControl>
