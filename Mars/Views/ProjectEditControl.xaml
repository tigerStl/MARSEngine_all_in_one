<mars:MarsProjectBaseControlView x:Class="Mars.Views.ProjectEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mars="clr-namespace:Mars.Views.baseView" 
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:Helper="clr-namespace:Mars.Helpers"
             xmlns:vab="clr-namespace:Microsoft.Practices.EnterpriseLibrary.Validation.Integration.WPF;assembly=Microsoft.Practices.EnterpriseLibrary.Validation.Integration.WPF"
             d:DesignHeight="600" 
                 mars:Title="{Binding Title}"
                                 
                          >
    <UserControl.Resources>
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
    </UserControl.Resources>
    
        <Grid VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
        
        </Grid.RowDefinitions>
            <!--Defined Column-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"></ColumnDefinition>
                <ColumnDefinition Width="7"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <Label Content="Project Edit" FontSize="20" x:Name="lblHeader" FontWeight="Bold"></Label>
            </StackPanel>
            <!--First Column Content-->
            <Label Content="Test Suite" Grid.Column="0" Grid.Row="1" Margin="5" FontWeight="SemiBold"></Label>

            <!--Second Column Content-->
            <ListView Name="listTestSuite" Grid.Column="2" Grid.Row="1" Margin="5" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                  ItemsSource="{Binding Path=TestSuite}"                  
                  ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="200"
                  IsSynchronizedWithCurrentItem="True"
                  Helper:GridViewSort.AutoSort="True">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Select" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Test Suite" Width="150" DisplayMemberBinding="{Binding TEST_SUITE_NAME}" Helper:GridViewSort.PropertyName="TEST_SUITE_NAME"/>
                        <GridViewColumn Header="Application" Width="150" DisplayMemberBinding="{Binding APP_SHORT_NAME}" Helper:GridViewSort.PropertyName="APP_SHORT_NAME"/>
                        <GridViewColumn Header="Version" Width="100" DisplayMemberBinding="{Binding VERSION}" Helper:GridViewSort.PropertyName="VERSION"/>
                    </GridView>
                </ListView.View>
            </ListView>


            <WrapPanel Grid.Column="3" Grid.Row="2" >
                <Button Content="Save" Width="70" Height="24" Margin="5" Command="{Binding SaveCommand}"></Button>
                <Button Content="Cancel" Width="70" Height="24" Margin="5" Command="{Binding ClearCommand}"></Button>
            </WrapPanel>
            <WrapPanel Grid.Column="2" Grid.Row="3" >
                <TextBlock Name="ProjectEditControlStatus" Text="{Binding ProjectEditControlStatus}" FontWeight="Bold" Background="#FFF5E008" />
            </WrapPanel>
            <!--Third Column Content-->

            <Image Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" Margin="21,10" Width="100" />


        </Grid>
    
</mars:MarsProjectBaseControlView>
