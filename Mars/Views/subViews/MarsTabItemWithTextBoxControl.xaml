<UserControl x:Class="Mars.Views.subViews.MarsTabItemWithTextBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.Views.subViews"
             xmlns:con="clr-namespace:Mars.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Loaded="UserControl_Loaded" LayoutUpdated="UserControl_LayoutUpdated" >
    <UserControl.Resources>
        <con:MarsTabWidthAdjustmentConvert x:Key="MarsTabWidthAdjustmentConvert"></con:MarsTabWidthAdjustmentConvert>
        <con:MarsTabHeightAdjustmentConvert x:Key="MarsTabHeightAdjustmentConvert"></con:MarsTabHeightAdjustmentConvert>
    </UserControl.Resources>
    <Grid x:Name="_hostGrid" Loaded="_hostGrid_Loaded"
          Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type TabControl}},Path=ActualWidth,Converter={StaticResource MarsTabWidthAdjustmentConvert},ConverterParameter=10}"
          Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type TabControl}},Path=ActualHeight,Converter={StaticResource MarsTabHeightAdjustmentConvert},ConverterParameter=40}"
          
          >
        <Grid.RowDefinitions>
            <RowDefinition Height="18"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Content="Input Data below:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top"></Label>
        <DockPanel Grid.Row="1" Grid.Column="0"  x:Name="_hostPanel" 
                   
                   >
            <!--Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type Grid}},Path=ActualWidth}"
                   Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type Grid}},Path=ActualHeight}"-->
            <TextBox Margin="3" AcceptsReturn="True" Text="{Binding Content}" BorderBrush="LightGray" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" > </TextBox>
        </DockPanel>
    </Grid>
</UserControl>
