<mars:MarsBaseViewControl x:Class="Mars.Views.ObjectDatabaseAddControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:Helper="clr-namespace:Mars.Helpers"
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             d:DesignHeight="400" d:DesignWidth="300">
    <!--Title="Add Object"-->
    <UserControl.Resources>
        <!--
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
        <DataTemplate x:Key="myTemplate" DataType="ValidationExample.MyData">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Division: "/>
                <TextBlock Text="{Binding Path=Division}"/>
            </StackPanel>
        </DataTemplate>

        <ControlTemplate x:Key="errorTemplate">
            <StackPanel>
                <TextBlock Foreground="Red">Invalid Value!!!</TextBlock>
                <AdornedElementPlaceholder/>
            </StackPanel>
        </ControlTemplate>
-->
        <ControlTemplate x:Key="TextBoxErrorTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" 
        Foreground="Orange"  FontSize="12pt">!</TextBlock>

                <Border BorderBrush="Red" BorderThickness="1">
                    <AdornedElementPlaceholder />
                </Border>
            </DockPanel>
        </ControlTemplate>

    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"   >
        <Border CornerRadius="3" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,3,0">
        <Grid Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="64"></RowDefinition>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="34"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <!--Defined Column-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="2" MinWidth="1"></ColumnDefinition>
                <ColumnDefinition Width="*" MaxWidth="300" ></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  Margin="3">
                <Label x:Name="lblHeader" Content="Object Detail" FontSize="18" Margin="3" ></Label>
            </StackPanel>
            <!--First Column Content-->
            <Label Content="Name" Grid.Column="0" Grid.Row="1" Margin="5" ></Label>
            <Label Content="Type" Grid.Column="0" Grid.Row="2" Margin="5" ></Label>
            <Label Content="Internal Name" Grid.Column="0" Grid.Row="3" Margin="5" ></Label>
            <Label Content="Application / Version" Grid.Column="0" Grid.Row="4" Margin="5" ></Label>
            <Label Content="Pegwindow / Parent" Grid.Column="0" Grid.Row="5" Margin="5" ></Label>
            <Label Content="Description" Grid.Column="0" Grid.Row="6" Margin="5" ></Label>
            <Label Content="Enum Type" Grid.Column="0" Grid.Row="7" Margin="5" ></Label>

            <!--Second Column Content-->
            <TextBox Name="txtName" Validation.ErrorTemplate="{StaticResource TextBoxErrorTemplate}" 
                 
                     Grid.Column="2" Grid.Row="1" Margin="3">
                <TextBox.Text>
                    <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">                       
                    </Binding>
                </TextBox.Text>
            </TextBox><!---->
            <ComboBox x:Name="cbxType"
                  Grid.Column="2" Grid.Row="2"                   
                  ItemsSource="{Binding Path=TypeList}"
                  SelectedItem="{Binding TypeStatus, Mode=TwoWay}"
                  SelectedValuePath="TYPE_ID"
                  DisplayMemberPath="TYPE_NAME"
                  Margin="3">
            </ComboBox>
                
                <TextBox Name="txtInternalName" Validation.ErrorTemplate="{StaticResource TextBoxErrorTemplate}" 
                 Grid.Column="2" Grid.Row="3" Margin="3">
                <TextBox.Text>
                    <Binding Path="InternalName" UpdateSourceTrigger="PropertyChanged"  >                       
                    </Binding>
                </TextBox.Text>
            </TextBox>
                
            <ComboBox x:Name="cbxApplication"
                  Grid.Column="2" 
                  Grid.Row="4"                    
                  ItemsSource="{Binding Path=RegisterdApplication}"
                  SelectedItem="{Binding SelectedApplication, Mode=TwoWay}" Margin="3">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} v{1}">
                                    <Binding Path="APP_SHORT_NAME"/>
                                    <Binding Path="VERSION"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox x:Name="cbxPegwindow"
                      Grid.Column="2" Grid.Row="5"                   
                      ItemsSource="{Binding Pegwindow}"                      
                      SelectedIndex="{Binding PegwindowStatus,Mode=OneWayToSource}"                  
                      Margin="3">
            </ComboBox>
            <TextBox x:Name="Description" Grid.Column="2" Grid.Row="6" TextWrapping="Wrap"
                  AcceptsReturn="True" Margin="3"
                  VerticalScrollBarVisibility="Visible">
                <TextBox.Text>
                    <Binding Path="Description" UpdateSourceTrigger="PropertyChanged"  >                        
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Name="txtEnumType" Validation.ErrorTemplate="{StaticResource TextBoxErrorTemplate}" 
                 Grid.Column="2" Grid.Row="7" Margin="3">
                <TextBox.Text>
                    <Binding Path="EnumType" UpdateSourceTrigger="PropertyChanged"  >                       
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <WrapPanel Grid.Column="2" Grid.Row="8" >
                <Button Content="Save" Width="70" Height="24" Margin="5" Command="{Binding SaveCommand}"></Button>
                <Button x:Name="btnCancel" Content="Cancel" Width="70" Height="24" Margin="5" Command="{Binding ClearCommand}"></Button>
            </WrapPanel>

            <WrapPanel Grid.Column="3" Grid.Row="9" >
                <TextBlock Name="ObjectdatabaseControlStatus" Text="{Binding ObjectdatabaseControlStatus}" FontWeight="Bold" Background="#FFF5E008" />
            </WrapPanel>
        </Grid>
        </Border>
    </ScrollViewer>
</mars:MarsBaseViewControl>
