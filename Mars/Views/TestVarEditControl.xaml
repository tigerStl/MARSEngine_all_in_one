<mars:MarsBaseViewControl x:Class="Mars.Views.TestVarEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mars="clr-namespace:Mars.Views.baseView"
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:Mars.ViewModel"
             xmlns:con="clr-namespace:Mars.Converter"
             xmlns:Helper="clr-namespace:Mars.Helpers"
             xmlns:mv="clr-namespace:Mars.Validate"             
             d:DesignHeight="500" d:DesignWidth="300" Width="400" DataContextChanged="UserControl_DataContextChanged">
    <UserControl.Resources>
            <con:BaseCompConverter x:Key="BaseCompConverter" />
            <!--
        <con:WidthConverter x:Key="widthConverter"></con:WidthConverter>
        <DataTemplate x:Key="myTemplate" DataType="ValidationExample.MyData">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Division: "/>
                <TextBlock Text="{Binding Path=Division}"/>
            </StackPanel>
        </DataTemplate>

        <ControlTemplate x:Key="errorTemplate">
            <StackPanel> 
                <TextBlock Foreground="Red">Invalid Value!!!</TextBlock>
                <AdornedElementPlaceholder/>
            </StackPanel>
        </ControlTemplate>
-->

        <ControlTemplate x:Key="TextBoxErrorTemplate">
            <DockPanel LastChildFill="True">
                <!--<TextBlock DockPanel.Dock="Top" Foreground="Red"  FontSize="9pt">! Please Check Value</TextBlock>-->
                <AdornedElementPlaceholder x:Name="_el" />
                <TextBlock Margin="0,0,6,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="Red"
                               Text="{Binding [0].ErrorContent}" />
            </DockPanel>
        </ControlTemplate>

    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"   >
        <Border CornerRadius="3" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,3,0">
            <Grid Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"></RowDefinition>
                    <RowDefinition Height="32"></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="32"></RowDefinition>
                    <RowDefinition Height="32"></RowDefinition>
                    <RowDefinition Height="32"></RowDefinition>
                    <RowDefinition Height="88"></RowDefinition>
                    <RowDefinition Height="88"></RowDefinition>
                    <RowDefinition Height="32"></RowDefinition>
                    <RowDefinition Height="34"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <!--Defined Column-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"></ColumnDefinition>
                    <ColumnDefinition Width="2" MinWidth="1"></ColumnDefinition>
                    <ColumnDefinition Width="*" ></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  Margin="3">
                    <Label x:Name="lblHeader" Content="Test Variable Editor" FontSize="20" Margin="3" ></Label>
                </StackPanel>

                <Label Content="Name:" Grid.Column="0" Grid.Row="1" Margin="5" ></Label>
                <TextBox Name="txtName" Validation.ErrorTemplate="{StaticResource TextBoxErrorTemplate}"
                    Grid.Column="2" Grid.Row="1" Margin="3,2,3,4">
                    <TextBox.Text>
                        <Binding Path="FIELD_NAME" UpdateSourceTrigger="LostFocus" Mode="TwoWay" ValidatesOnExceptions="true">
                            <Binding.ValidationRules>
                                <mv:IsNullValidateRule ErrorMessage="Var Name is Required!"></mv:IsNullValidateRule>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>

                </TextBox>
                
                <!---->
                <Label Content="Value:" Grid.Column="0" Grid.Row="2" Margin="5" ></Label>
                <TextBox Name="txtValue" Validation.ErrorTemplate="{StaticResource TextBoxErrorTemplate}" AcceptsReturn="True" Height="50"
                    Grid.Column="2" Grid.Row="2" Margin="3,2,3,4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TextBox.Text>
                        <Binding Path="DISPLAY_NAME" UpdateSourceTrigger="LostFocus" Mode="TwoWay" ValidatesOnExceptions="true">
                            <Binding.ValidationRules>
                                <mv:IsNullValidateRule ErrorMessage="Object Name is important!"></mv:IsNullValidateRule>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>

                </TextBox>
                
                
                <!---->
               

                <Label Content="Type:" Grid.Column="0" Grid.Row="3" Margin="5" ></Label>
                <ComboBox x:Name="cbxVarType" Grid.Column="2" Grid.Row="3" Margin="3"
                          SelectionChanged="cbxVarType_SelectionChanged" LostFocus="cbxVarType_LostFocus"
                          SelectedItem="{Binding TABLE_NAME}"
                          >
                    <!--
                    <ComboBoxItem Name="cbi1">GLOBAL_VAR</ComboBoxItem>
                    <ComboBoxItem Name="cbi2">MODAL_VAR</ComboBoxItem>
                    -->
                </ComboBox>


                <Label Content="Baseline/Compare" Grid.Column="0" Grid.Row="4" Margin="5" ></Label>
                <ComboBox x:Name="cbxBse" Grid.Column="2" Grid.Row="4" Margin="3" 
                            
                            SelectedValue="{Binding CurrentStatus, Converter={StaticResource BaseCompConverter}}"
                          >
                    
                    <!--
                    SelectionChanged="cbxBse_SelectionChanged"  
                    DisplayMemberBinding="{Binding STATUS, Converter={StaticResource BaseCompConverter}}"
                    <ComboBoxItem Name="cbv1">BASELINE</ComboBoxItem>
                    <ComboBoxItem Name="cbv2">COMPARE</ComboBoxItem>
                    -->
                </ComboBox>

                <!--
                 SelectedValue="{Binding TABLE_NAME}"
                          SelectedValuePath="Name" 
                          DisplayMemberPath="Name"
                -->
               

                <!--SelectedItem="{Binding PegwindowStatus,Mode=OneWayToSource}"-->

             

               

              


             

                <DockPanel Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="3" Margin="5,0,5,0" LastChildFill="False" >
                    <Button Content="Delete" DockPanel.Dock="Right" Width="70" Height="24" Margin="5" Click="Button_Click" Tag="DELETE"></Button>
                    <Button Content="Update" DockPanel.Dock="Right" Width="70" Height="24" Margin="5" Click="Button_Click" Tag="UPDATE"></Button>
                    <Button Content="Insert" DockPanel.Dock="Right" Width="70" Height="24" Margin="5" Click="Button_Click" Tag="INSERT"></Button>
                   
                    <!--<Button x:Name="btnCancel" Content="Cancel" Width="70" Height="24" Margin="5" Command="{Binding ClearCommand}"></Button>-->
                </DockPanel>

               
                <StackPanel Grid.Column="0" Grid.Row="10" Grid.ColumnSpan="3">
                    <TextBlock DockPanel.Dock="Top" Foreground="Red"  FontSize="9pt" x:Name="txtError"></TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</mars:MarsBaseViewControl>
