<UserControl x:Class="Mars.Views.objectManagement.ObjectDataSourceDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mars.Views.objectManagement"
             xmlns:col="clr-namespace:System.Collections;assembly=mscorlib"             
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <col:ArrayList x:Key="paramType" >
            <col:DictionaryEntry Key="String" Value="String"/>
            <col:DictionaryEntry Key="Int" Value="Int"/>
            <col:DictionaryEntry Key="Float" Value="Float(Including double)"/>
            <col:DictionaryEntry Key="Date" Value="Date"/>
        </col:ArrayList>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Label Content="Object Datasource Definition:" FontWeight="Bold" FontSize="14" Margin="3" ></Label>
            <Label Content="{Binding CurrentObjectDataSource.CurrentObjectName}" Margin="3"></Label>
        </StackPanel>
        <Label Content="Mapping From Field:" Grid.Row="1" Grid.Column="0" Margin="3"></Label>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="3" Text="{Binding CurrentObjectDataSource.FieldMappingFrom}"></TextBox>
        
        <Label Content="Parameters Required:" Grid.Row="2" Grid.Column="0" Margin="3"></Label>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <Button Content=" Add " Margin="3" Command="{Binding CurrentObjectDataSource.OnAddOneParameterClick}"></Button>
            <Button Content=" Del " Margin="3" Command="{Binding CurrentObjectDataSource.OnDelParameterClick}"></Button>
            <Button Content="Clear" Margin="3" Command="{Binding CurrentObjectDataSource.OnClearParameterClick}"></Button>
        </StackPanel>
        <DataGrid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,3,3,3" Height="100"
                  ItemsSource="{Binding CurrentObjectDataSource.CurrentParamenters}"
                  SelectedItem="{Binding CurrentObjectDataSource.CurrentSelectedParameter}"
                  CanUserAddRows="False" AutoGenerateColumns="False" CellEditEnding="DataGrid_CellEditEnding"
                  >
            
            <DataGrid.Columns>
                <DataGridTextColumn ClipboardContentBinding="{x:Null}" Header="Parameter Friendly Name"
                                    Binding="{Binding DisplayName}"
                                    
                                    />
                <DataGridTextColumn Binding="{Binding ParameterName}" ClipboardContentBinding="{x:Null}" Header="Parameter Name"/>
                <DataGridComboBoxColumn  Header="Type" ItemsSource="{StaticResource paramType}"
                                         DisplayMemberPath="Key"
                                         SelectedItemBinding="{Binding SourceType}"
                                         >
                </DataGridComboBoxColumn>
                <DataGridCheckBoxColumn Header="Is Arrary?" Binding="{Binding IsArray}"></DataGridCheckBoxColumn>
            </DataGrid.Columns>

        </DataGrid>

        <Label Content="SQL:" FontWeight="Bold" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="3"></Label>
        <DockPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,3,3,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" AcceptsReturn="True" Text="{Binding CurrentObjectDataSource.CurrentSql}"></TextBox>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Margin="3">
                    <Button Content=" Test SQL " Margin="0,0,0,5" Command="{Binding CurrentObjectDataSource.OnTestSqlBtnClick}"></Button>
                    <Button Content=" Save " Margin="0,0,0,5" Command="{Binding CurrentObjectDataSource.OnSaveBtnClick}"></Button>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
