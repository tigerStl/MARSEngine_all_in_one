    <None Remove="AutoSteps\**" />
    <None Remove="dllEntry\**" />
    <None Remove="interfaceMain\**" />
    <None Remove="keywords\**" />
    <None Remove="lang\**" />
    <None Remove="restClient\**" />
    <None Remove="utilities\**" />
