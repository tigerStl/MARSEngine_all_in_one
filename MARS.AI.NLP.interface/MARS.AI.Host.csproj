    <EmbeddedResource Remove="AutoSteps\**" />
    <EmbeddedResource Remove="dllEntry\**" />
    <EmbeddedResource Remove="interfaceMain\**" />
    <EmbeddedResource Remove="keywords\**" />
    <EmbeddedResource Remove="lang\**" />
    <EmbeddedResource Remove="restClient\**" />
    <EmbeddedResource Remove="utilities\**" />
    <EmbeddedResource Remove="verb\**" />
