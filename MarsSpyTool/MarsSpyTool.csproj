  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Microsoft.Playwright MSBuild copies .playwright only into MARS.WebAutomation\bin\$(Configuration)\net48\.
    The host EXE (MarsSpyTool) loads Playwright from $(TargetDir); drivers must exist next to the EXE (see Playwright docs).
    After Build/Publish, mirror .playwright + playwright.ps1 from WebAutomation output into this project's output/publish folder.
  -->
  <Target Name="CopyPlaywrightDriverFromWebAutomation" AfterTargets="Build">
    <PropertyGroup>
      <_WebAutomationOutDir>$(MSBuildProjectDirectory)\..\MARS.WebAutomation\bin\$(Configuration)\net48</_WebAutomationOutDir>
      <_PlaywrightDestDir>$([MSBuild]::EnsureTrailingSlash('$(TargetDir)'))</_PlaywrightDestDir>
      <_PlaywrightDestPlaywright>$(_PlaywrightDestDir).playwright</_PlaywrightDestPlaywright>
    </PropertyGroup>
    <!-- Robocopy uses exit 0-7 for success; normalize so MSBuild does not treat 1 as failure. -->
    <Exec Command="cmd /c robocopy &quot;$(_WebAutomationOutDir)\.playwright&quot; &quot;$(_PlaywrightDestPlaywright)&quot; /E /XO /NJH /NJS /NC /NS /NP /NFL /NDL &amp; if errorlevel 8 (exit /b 1) else (exit /b 0)"
          Condition="Exists('$(_WebAutomationOutDir)\.playwright')" />
    <Copy SourceFiles="$(_WebAutomationOutDir)\playwright.ps1"
          DestinationFiles="$(_PlaywrightDestDir)playwright.ps1"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_WebAutomationOutDir)\playwright.ps1')" />
    <Warning Text="Playwright driver folder missing: $(_WebAutomationOutDir)\.playwright - build project MARS.WebAutomation with configuration $(Configuration) first, then from that folder run: pwsh -File playwright.ps1 install"
             Condition="!Exists('$(_WebAutomationOutDir)\.playwright')" />
  </Target>
  <Target Name="CopyPlaywrightDriverFromWebAutomationPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_WebAutomationOutDir>$(MSBuildProjectDirectory)\..\MARS.WebAutomation\bin\$(Configuration)\net48</_WebAutomationOutDir>
      <_PlaywrightDestDir Condition="'$(PublishDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_PlaywrightDestDir>
      <_PlaywrightDestDir Condition="'$(_PlaywrightDestDir)' == ''">$([MSBuild]::EnsureTrailingSlash('$(TargetDir)'))</_PlaywrightDestDir>
      <_PlaywrightDestPlaywright>$(_PlaywrightDestDir).playwright</_PlaywrightDestPlaywright>
    </PropertyGroup>
    <Exec Command="cmd /c robocopy &quot;$(_WebAutomationOutDir)\.playwright&quot; &quot;$(_PlaywrightDestPlaywright)&quot; /E /XO /NJH /NJS /NC /NS /NP /NFL /NDL &amp; if errorlevel 8 (exit /b 1) else (exit /b 0)"
          Condition="Exists('$(_WebAutomationOutDir)\.playwright')" />
    <Copy SourceFiles="$(_WebAutomationOutDir)\playwright.ps1"
          DestinationFiles="$(_PlaywrightDestDir)playwright.ps1"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_WebAutomationOutDir)\playwright.ps1')" />
    <Warning Text="Playwright driver folder missing: $(_WebAutomationOutDir)\.playwright - build project MARS.WebAutomation with configuration $(Configuration) first, then from that folder run: pwsh -File playwright.ps1 install"
             Condition="!Exists('$(_WebAutomationOutDir)\.playwright')" />
  </Target>
