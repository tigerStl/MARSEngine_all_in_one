<Window x:Class="MarsSpyTool.Utility.License.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MARS License 激活" 
        Height="450" 
        Width="600" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/eyeMars.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MARS Spy Tool License 激活" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="请输入您的 License Key 以激活产品" 
                       FontSize="12" 
                       Foreground="Gray" 
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- License Key 输入 -->
        <GroupBox Grid.Row="1" Header="License Key" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <TextBox x:Name="LicenseKeyTextBox" 
                         Height="80" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Padding="5"/>
                <TextBlock Text="请粘贴完整的 License Key" 
                           FontSize="10" 
                           Foreground="Gray" 
                           Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 硬件信息 -->
        <GroupBox Grid.Row="2" Header="机器信息" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="硬件ID:" FontWeight="Bold" Margin="0,0,10,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" 
                             x:Name="HardwareIdTextBox" 
                             IsReadOnly="True" 
                             Background="#F5F5F5"
                             FontFamily="Consolas"
                             FontSize="10"
                             Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="用户名:" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             x:Name="UsernameTextBox" 
                             IsReadOnly="True" 
                             Background="#F5F5F5"/>
                </Grid>
                <TextBlock Text="购买 License 时请提供硬件ID给销售人员" 
                           FontSize="10" 
                           Foreground="Gray" 
                           Margin="0,10,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 当前 License 信息 -->
        <GroupBox Grid.Row="3" Header="当前 License 状态">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LicenseInfoPanel" Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="授权给:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LicensedToText" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="License 类型:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LicenseTypeText" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="激活状态:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ActivationStatusText" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="激活日期:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ActivationDateText" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="过期日期:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ExpirationDateText" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="剩余天数:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="RemainingDaysText" Margin="0,0,0,8"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="激活" 
                    Width="100" 
                    Height="32" 
                    Click="ActivateButton_Click"
                    Margin="0,0,10,0"
                    IsDefault="True"/>
            <Button Content="关闭" 
                    Width="100" 
                    Height="32" 
                    Click="CloseButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

