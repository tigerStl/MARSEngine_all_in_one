<Window x:Class="MarsSpyTool.subToolWindows.hintWindows.MarsHintWindowSelectApplication"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MarsSpyTool.subToolWindows.hintWindows"
        mc:Ignorable="d"
        Title="Select Application" Height="160" Width="401" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow"
        
        >   
    <Grid HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Grid.ColumnSpan="2">
            <Label x:Name="label" Content="Please Make sure TEST will generate test Steps for the application:" HorizontalAlignment="Left" Margin="5" Grid.Row="1" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" LastChildFill="True" Grid.ColumnSpan="2">
            <ComboBox 
                Width="321" Margin="35, 5, 5,5" 
                ItemsSource="{Binding ApplicationsToBeConfirmed}"
                SelectedItem="{Binding SelectedApplication}"
                >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} | {1}">
                                    <Binding Path="ApplicationName" />
                                    <Binding Path="ApplicationProcess"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel></StackPanel>
        </DockPanel>
        <!--
        buttons
        -->
        <DockPanel LastChildFill="True" Grid.Row="2" Grid.ColumnSpan="2">
            <StackPanel Width="135"></StackPanel>
            <Button Margin="5" Width="100" Content="Ok" Click="Button_Click" IsDefault="True" ></Button>
            <Button Margin="5" Width="100" Content="No" IsCancel="True"></Button>
            <StackPanel></StackPanel>
        </DockPanel>
    </Grid>
</Window>
