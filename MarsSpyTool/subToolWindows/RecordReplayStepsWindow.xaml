<Window x:Class="MarsSpyTool.subToolWindows.RecordReplayStepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MarsSpyTool.subToolWindows"        
        mc:Ignorable="d"
        Closing="OnStepwindow_Closing"
        
        Title="MARS RECORD&amp;REPLAY MONITOR" Height="120" Width="600" Icon="/subToolWindows/eyeMars.png" WindowStyle="None">
    <Window.Resources>
        <local:MarsIndexConverter x:Key="IndexConverter"/>
    </Window.Resources>
    <DockPanel>
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="133"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"></RowDefinition>
                <RowDefinition Height="*" MinHeight="35"></RowDefinition>
                <RowDefinition Height="35"></RowDefinition>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="MARS Test step Monitor" Grid.ColumnSpan="3">
            </Label>
            <DockPanel Grid.Row="1" Grid.Column="0" 
                       LastChildFill="True"
                       Grid.RowSpan="2"
                       >
                <Label Content="{Binding currentStatus}" Foreground="Blue" Grid.ColumnSpan="3">
                </Label>
            </DockPanel>
            <DockPanel Grid.Row="0" LastChildFill="True" 
                   Grid.Column="1"
                   Grid.RowSpan="3"
                   Margin="5,5,5,5" >
                <!--<ListBox x:Name="stepsListBoxx" ItemsSource="{Binding stepsListBox,UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="0" Grid.ColumnSpan="1"
                 Grid.RowSpan="2"
                 ></ListBox>-->
                <DataGrid x:Name="TestStepDataGrid" AutoGenerateColumns="False" HeadersVisibility="None" 
                  ItemsSource="{Binding TestSteps}" CanUserAddRows="False" 
                          SelectedItem="{Binding SelectedTestStep, Mode=TwoWay}"
                          SelectionMode="Single"
                          CanUserResizeColumns="True"
                          IsReadOnly="True"
                          RowHeight="18" FontSize="9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Index" Width="Auto" Binding="{Binding Run_order}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontSize" Value="9"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TestStepInfo}" Width="*" Header="Step details">
                            <!--<DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontSize" Value="9"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>-->
                        </DataGridTextColumn>

                        <!-- Action Column -->
                        <DataGridTemplateColumn Width="110">
                            <!--<DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Action" FontSize="9" FontWeight="Bold" Foreground="DarkBlue" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>-->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">                                        
                                        <Button Content="Remove" Margin="5,0" Width="80"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    
                    <DataGrid.Resources>
                        <!-- Style for DataGridCell -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="1,1" />
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
            </DockPanel>
            <StackPanel Height="33" Grid.Column="2" Orientation="Horizontal" Grid.Row="1">
                <Button                     
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Center"
                    Height="27"
                    Margin="3" 
                    Width="80" 
                    Command="{Binding Path=save2MarsClick}">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/icons/icons8-save-48.png" Height="20" 
                            HorizontalAlignment="Left"
                            Margin="0,0,5,0">                           
                        </Image>
                        <TextBlock Grid.Column="1" Text="Save" HorizontalAlignment="Center" />
                    </Grid>
                </Button>
                <Button 
                        VerticalAlignment="Bottom" 
                        HorizontalAlignment="Center"
                        Height="27"
                        Margin="3" 
                        Width="80"
                        Command="{Binding Path=replayMarsClick}"
                >
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/icons/icons8-replay-48.png" Height="20" 
        HorizontalAlignment="Left"
        Margin="0,0,5,0">
                        </Image>
                        <TextBlock Grid.Column="1" Text="Replay" HorizontalAlignment="Center" />
                    </Grid>
                </Button>

            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                Grid.Row="0">
                <Button Name="DockButton"            
                    Width="80"                     
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Center"
                        Height="27"
                    Margin="3" 
                    Click="DockButton_Click">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/icons/icons8-boat-location-48.png" Height="20" 
           HorizontalAlignment="Left"
           Margin="0,0,5,0"></Image>
                        <TextBlock Grid.Column="1" Text="Dock to >" HorizontalAlignment="Center" />
                    </Grid>
                </Button>

                <Button Margin="3"  Height="27"
                         Width="80" 
                        VerticalAlignment="Bottom" 
                        HorizontalAlignment="Center"
                        ToolTip="Close Record And Replay window"
                        Click="CloseButtonClick">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/icons/icons8-close-48.png" Height="20" 
                               HorizontalAlignment="Left"
                               Margin="0,0,5,0"></Image>
                        <TextBlock Grid.Column="1" Text="Close" HorizontalAlignment="Left" />
                    </Grid>
                </Button>

            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal"
    Grid.Row="2">
                <Button  Width="169" Height="27"                         
                        Command="{Binding Path=EditStepsInEditor}">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/icons/icons8-transfer-48.png" Height="20" 
                           HorizontalAlignment="Left"
                           Margin="0,0,5,0"></Image>
                        <TextBlock Grid.Column="1" Text="Bring to Editor" HorizontalAlignment="Left" />
                    </Grid>
                </Button>
            </StackPanel>
            <!-- Popup Menu -->
            <Popup Name="DockMenuPopup" PlacementTarget="{Binding ElementName=DockButton}" 
                   StaysOpen="False">
                <StackPanel Background="White" Width="120">
                    <MenuItem Header="_Top"    Tag="Top"  Click="MenuItem_Click" Name="TopMenuItem">
                        <MenuItem.Icon>
                            <Image Source="icons\icons8-top-50.png" Height="32"></Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Left"   Tag="Left"  Click="MenuItem_Click" Name="LeftMenuItem"/>
                    <MenuItem Header="_Right"  Tag="Right"  Click="MenuItem_Click" Name="RightMenuItem"/>
                    <MenuItem Header="_Bottom" Tag="Bottom"  Click="MenuItem_Click" Name="BottomMenuItem" IsCheckable="True" IsChecked="True"/>
                </StackPanel>
            </Popup>
        </Grid>
        
    </DockPanel>
</Window>
