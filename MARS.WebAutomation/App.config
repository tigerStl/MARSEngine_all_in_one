<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Default UI language: en / zh-CN -->
    <add key="UiLanguage" value="en" />
    <add key="RecorderEngineScriptFile" value="scripts\\recorder.install.js" />
    <add key="RecorderSemanticConfigJson" value="{&quot;targetHtmlTag&quot;:&quot;a&quot;,&quot;targetSemanticType&quot;:&quot;semi&quot;,&quot;maxParentDepth&quot;:5,&quot;stopParentTags&quot;:[&quot;ul&quot;,&quot;table&quot;],&quot;stopParentObjectTypes&quot;:[&quot;webTable&quot;,&quot;webMenu&quot;],&quot;parentsSemanticRules&quot;:[{&quot;priority&quot;:200,&quot;htmlTag&quot;:&quot;li&quot;,&quot;semanticType&quot;:&quot;full&quot;,&quot;classIncludes&quot;:[&quot;kt-menu&quot;,&quot;kt-menu__item&quot;],&quot;objectType&quot;:&quot;webMenu&quot;,&quot;requiredProperties&quot;:[&quot;webClass&quot;,&quot;textPreview&quot;]},{&quot;priority&quot;:180,&quot;htmlTag&quot;:&quot;button&quot;,&quot;semanticType&quot;:&quot;semi&quot;,&quot;classIncludes&quot;:[&quot;kt-button&quot;],&quot;objectType&quot;:&quot;webButton&quot;,&quot;requiredProperties&quot;:[&quot;webClass&quot;,&quot;textPreview&quot;]}],&quot;selfSemanticRules&quot;:[{&quot;priority&quot;:300,&quot;htmlTag&quot;:&quot;*&quot;,&quot;semanticType&quot;:&quot;full&quot;,&quot;properties&quot;:[{&quot;property&quot;:&quot;role&quot;,&quot;value&quot;:&quot;tablist&quot;,&quot;method&quot;:&quot;equal&quot;},{&quot;property&quot;:&quot;class&quot;,&quot;value&quot;:&quot;context-tab&quot;,&quot;method&quot;:&quot;include&quot;}],&quot;objectType&quot;:&quot;webTab&quot;,&quot;requiredProperties&quot;:[&quot;textPreview&quot;,&quot;webClass&quot;,&quot;webChildrenTargetTag&quot;],&quot;propertyMappings&quot;:[{&quot;name&quot;:&quot;textPreview&quot;,&quot;source&quot;:&quot;children:a.innerText&quot;},{&quot;name&quot;:&quot;webClass&quot;,&quot;source&quot;:&quot;self.class&quot;},{&quot;name&quot;:&quot;webId&quot;,&quot;source&quot;:&quot;self.id&quot;,&quot;optional&quot;:true},{&quot;name&quot;:&quot;webIdPath&quot;,&quot;source&quot;:&quot;self.idPath&quot;,&quot;optional&quot;:true},{&quot;name&quot;:&quot;webXpath&quot;,&quot;source&quot;:&quot;self.xpath&quot;,&quot;optional&quot;:true},{&quot;name&quot;:&quot;webChildrenTargetTag&quot;,&quot;source&quot;:&quot;const:a&quot;}]}],&quot;childrenTargetRules&quot;:{&quot;tag&quot;:&quot;a&quot;,&quot;textSource&quot;:&quot;selfOrChild.innerText&quot;,&quot;textMatchMode&quot;:&quot;exact&quot;,&quot;allowRegex&quot;:true,&quot;mustBeUnique&quot;:true,&quot;onNoMatch&quot;:&quot;error&quot;,&quot;onAmbiguousMatch&quot;:&quot;error&quot;},&quot;keywordMapping&quot;:[{&quot;objectType&quot;:&quot;webTab&quot;,&quot;keyword&quot;:&quot;SelectTab&quot;},{&quot;objectType&quot;:&quot;webMenu&quot;,&quot;keyword&quot;:&quot;SelectMenuItem&quot;},{&quot;objectType&quot;:&quot;webButton&quot;,&quot;keyword&quot;:&quot;ClickButton&quot;}]}" />
  </appSettings>
</configuration>
