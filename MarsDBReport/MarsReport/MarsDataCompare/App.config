  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <add key="TempPicturePath" value="C:\automationTest\Automation Workbooks\tempImg" />
    <add key="SoftWareProvider" value="Misys US (NYC)" />
    <!--
    Federal Home Loan Bank of Chicago
    -->
    <add key="ClientFullName" value="Federal Home Loan Bank of Chicago" />
    <add key="ReportFirstPageHeader" value="MARS AUTO REGRESSION TESTING REPORT" />
    <add key="ReportPageEyebrow" value="MARS Automation Testing Framework" />
    <add key="REPORT_PATH" value="C:\automationTest\Automation Workbooks\Report" />
    <add key="REPORT_TEMPLATE_PATH" value="C:\automationTest\Automation Workbooks\ReportTemplates" />
    <add key="TestTargetApplication" value="SummitFT 6.0" />
    <!--value= true /false-->
    <add key="IsContinueLatestTest" value="true" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="MARSDBInstance" value="Oracle" />
    <add key="MARS_DB_PWD" value="BzajNZ29/UgNdc9Ompy4Kg==" />
    <add key="PROJ_EXP_DIR" value="C:\automationTest\Automation Workbooks\ExportProj" />
    <add key="IsAutoCheckError" value="true" />
    <!--
    <add key="DefaultSchema" value="TESTIDE2"/>
    -->
    <!--for non-qtp version-->
    <add key="DefaultWindowIds" value="Text:=((Misys ){0,1}(FusionCapital ){0,1}Summit( FT){0,1})(?!(.*Login)).*;swfname:=Desktop;index:=0" />
    <add key="WinMergePath" value="C:\Users\Alex\Downloads\winmerge-2.16.0-exe\WinMerge\WinMergeU.exe" />
    <!--
    <add key="MappingTableFileName" value="C:\automationTest\Automation Workbooks\Mapping\MappingData_Day3.xlsx"/>
    -->
    <add key="MappingTableFileName" value="C:\automationTest\Automation Workbooks\Mapping\MappingData_Day5.xlsx" />
    <!--default wait time-->
    <add key="DefaultWaitTime" value="120" />
    <!--for web mode-->
    <add key="CompareCallBackBaseUri" value="https://localhost:7263" />
  </appSettings>
  <log4net>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="LogFileAppender" />
      <appender-ref ref="DATACOMPARE" />
    </root>
    <appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="log/MarsIDE.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="5" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d [%t] %-5p %c %m%n" />
      </layout>
    </appender>
    <appender name="DATACOMPARE" type="log4net.Appender.RollingFileAppender">
      <file value="log/DataCompare.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="5" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d [%t] %-5p %c %m%n" />
      </layout>
    </appender>
    <logger name="DATACOMPARE">
      <level value="DEBUG" />
      <appender-ref ref="DATACOMPARE" />
    </logger>
    
  </log4net>
