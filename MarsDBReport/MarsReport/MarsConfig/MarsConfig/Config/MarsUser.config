<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <MarsEnvironments name="FROMWEB">

    <MarsEnvironment name="FROMWEB">
      <RegistedApplications>
        <RegApplication AppName="Summit5.6" Mode="Baseline"  command="" path="C:\summit\v5.6\FT_Front\SummitFT.exe" identifier="SummitFT.exe" ApplicationType="window" ExtraRequirement="INFRAGISTICS_V_14" ExtraPopupMenu="1"/>
        <RegApplication AppName="Summit6.1" Mode="Compare" command="" path="C:\summit\v6.1\FT_Front64\SummitFT.exe" identifier="SummitFT.exe" ApplicationType="window" ExtraRequirement="INFRAGISTICS_V_162" ExtraPopupMenu="1"/>
      </RegistedApplications>

      <LogPath path="%MARS_HOME%\log"></LogPath>
      <WebApi url="https://localhost:7263"></WebApi>
      <WebApiOption option="NEW"></WebApiOption>
      <WebApiSchema schema="SQL_GEN_MARS_5"></WebApiSchema>

      <DatabaseConnectionDetails
        Type="Oracle"
        Host="192.168.2.88"
        Port="1521"
        ServiceName="orcl.Marquis"
        ConnString=""
        EntityConnString=""
        Schema="GEN_MARS_5"
        UserName="GEN_MARS_5"
        Password="GEN_MARS_5"
		Name="default">
      </DatabaseConnectionDetails>

      <DatabaseConnectionDetails
          Type="SQLSERVER"
          Host="10.0.0.5"
          Port="1521"
          ServiceName="CIC_MARS1"
          ConnString="Data Source=10.0.0.5;Initial Catalog=CIC_MARS1;Persist Security Info=True;User ID=marsdb;Password=Marquis1234!;TrustServerCertificate=true;Encrypt=true;Max Pool Size=20;Connection Lifetime=5;"
          Schema="CIC_MARS1"
      UserName="marsdb"
      Password="Marquis1234!"
      Name="CIC_MARS1">
      </DatabaseConnectionDetails>

      <DataCompare
        TemplatePath="c:\temp\DataCompareTemplate"
        OutputPath="c:\temp\DataCompareOutput">
      </DataCompare>

      <ReportConfig
        REPORT_PATH="C:\software\MarsAutomation\Report"
          REPORT_TEMPLATE_PATH="C:\software\MarsAutomation\ReportTemplates"
      REPORT_IMAGE_PATH = "C:\software\MarsAutomation\ReportTemp"
      REPORT_TABLE_WORD = "CASHFLOW">
      </ReportConfig>

    </MarsEnvironment>

