        public enum COMP_ERR
        {
            COMP_ERR_SUCCESS = 0,
            COMP_ERR_INVALID_DIR,
            COMP_ERR_FOLDER_SAME,
            COMP_ERR_SAVE_FAILED,
            COMP_OUT_FILENAME
        }

        static Microsoft.Office.Interop.Excel.Application excelApp;

