  <CurrentUFTAddins>
    <!--all items here should be the same as QTP setting,
        Don't modify items if not necessary.
        Just comment items if it is not required for the current test.
        Tiger
      -->
    <add key=".NET" value=".NET">
    </add>
    <add key="Java" value="Java">
    </add>
    <add key="WPF" value="WPF">
    </add>
  </CurrentUFTAddins>
  
  <MarsPlugins>
    <MarsPlugin Type="MarsPlugin-TestSteps" Name="TestPlugins" Path="C:\automationTest\Automation Workbooks\dlls\TestPlugins.dll">      
    </MarsPlugin>
