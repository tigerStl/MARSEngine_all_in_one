<?xml version="1.0" encoding="utf-8"?>
<configuration>  
  <configSections>
    <section name="XlsConfigMode" type="System.Configuration.NameValueSectionHandler"/>
    <section name="RegistedApplications" type="com.Mars.Config.RegisterdApplictions, MarsTestFrame" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" restartOnExternalChanges="true" requirePermission="true"/>
    <section name="Keywords" type="com.Mars.KeyWords.KeyWordObject.KeyWordsSection, MarsTestFrame" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" restartOnExternalChanges="true" requirePermission="true"/>
    <!--
    <section name="MarsPlugins" type="MarsTestFrame.plugins.MarsPluginsLoader, MarsTestFrame" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" restartOnExternalChanges="true" requirePermission="true"/>
    -->
    <section name="UFTInitScripts" type="System.Configuration.NameValueSectionHandler"/>
    <section name="CurrentUFTAddins" type="System.Configuration.NameValueSectionHandler"/>
    <section name="FrameWorkService" type="System.Configuration.NameValueSectionHandler"/>

    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
    <section name="oracle.manageddataaccess.client" type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess"/>
  </configSections>
  
  <appSettings>
    <add key="RegistedApplicationsMode" value="config"/>
    <!--
    <add key="ObjectSource" value="xlsFile"/>
    -->
    <add key="TCDataSource" value="dataBase"/>    
    <add key="ObjectSource" value="dataBase"/>
    
    <!--
    <add key="TCDataSource" value="dataBase"/>
    -->
    <add key="KeywordSource" value="config"/>    
    <add key="DefautlApplication" value="ShortName:Sophis713"/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <add key="DebugMode" value="VBS"/>
    <!--Two values are avaible:build/comparison-->
    <add key="BaseLineMode" value="Build"/>
    <add key="QtpRoot" value="C:\Program Files (x86)\HP\Unified Functional Testing"/>
    <!-- pegwindow type,created on 11/10/2015 -->
    <add key="PegwindowType" value="Pegwindow;Window;Dialog;WpfWindow;SwfWindow"/>
  
    <!-- for Objects Database setting -->
    <add key="DatabaseModeConnection" value="Data Source = (DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = 192.168.2.99)(PORT = 1521))(CONNECT_DATA = (SERVICE_NAME = orcl.internal.marquis.nyc))); User Id = TESTIDE2; Password =TESTIDE2;"/>
    <add key="TestCaseDirectory" value="C:\Automation Workbooks\TC"/>
    <add key="DataDirectory" value="C:\Automation Workbooks\Data"/>

    <add key="GenerateAppFor" value="SophisValue.exe" />
    <add key="DefaultCacheApp-Objects" value="Opics4.x"/>
    <add key="SkipStepWords" value="SKIP;IGNORE"/>
    <add key="DataCompare" value="MarsCompare\MARSCompareGUI.exe"></add>
    <!--client logo-->
    <add key="CurrentClientLogo" value="C:\automationTest\Automation Workbooks\resource\ClientLogo\FHLBChicagologo.jpg"/>
    <add key="CurrentClientName" value="Federal Home Loan Bank of Chicago"/>
    
    <!--Xml Export/Import Dir-->
    <add key="ExportXmlDirectory" value="C:\automationTest\Automation Workbooks\XmlExportImport\Exp"/>
    <add key="ImportXmlDirectory" value="C:\automationTest\Automation Workbooks\XmlExportImport\Imp"/>
    
    <!--Pegwindow extenal-->
    <add key="CurrentPegWindowReplace" value="JavaWindow"/>
    <!--添加autocheck error-->
    <add key="IsAutoCheckError" value="True"/>
    <!--an extends, more than one checkError objects can be used-->
    <add key="_AUTO_ERROR_CHECK_OBJ_" value="_AUTO_ERROR_CHECK_OBJ_"/>
    <add key="CurrentAppShortName" value="Summit" />

    <add key="KeywordRequireAutocheckError" value ="ADDDays;ClickButton;ClickMenuIcon;ClickPopupMenuItem;ClickRadioButton;FillEdit;FillEditLookup;FillEditSuffix;FillTable;InsertEdit;InsertRow;LaunchApplication;PressKeys;PressTab;SearchAndClick;SearchAndUpdateTable;SelectDropDown;SelectListItem;SelectMenuItem;SelectTab;SetBox"/>
    <!--For different schema-->
    <!--<add key="DefaultSchema" value="GEN_MARS"/>-->
    <add key="DefaultSchema" value="GEN_MARS_5"/>
    <add key="ShellDir" value="d:\tmp\Mars\" />
  </appSettings>
  <XlsConfigMode>
    <add key="RootPath" value="C:\automationTest\Automation Workbooks">
    </add>
  </XlsConfigMode>
  <UFTInitScripts>
    <!--all path should be related path -->
    <add key="MarquisFunctionLibrary" value="TestCode\MarquisFunctionLibrary.qfl">
    </add>
    <add key="MarquisFunc_External" value="TestCode\MarquisFunc_External.vbs">
    </add>
    <add key="TestDriver" value="TestCode\TestDriver.vbs">
    </add>
    <add key="XmlCompare" value="TestCode\XmlCompare.qfl">
    </add>
    <add key="processMgr" value="TestCode\processMgr.vbs">
    </add>
